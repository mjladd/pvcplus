{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf2 (\
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  fluxoid = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		amplitude_weighting__0_off__1_on, \
		begintime, \
		gate_threshold_in_decibels, \
		window_type, \
		boundary_data_type, \
		analysis_channel, \
		amplitude_envelope_warp, \
		spectral_flux_file, \
		compression_threshold_in_decibels, \
		high_freq_or_pitch_boundary, \
		windowsize, \
		plot_output__yes_1__no_0, \
		attack_time_in_seconds, \
		low_freq_or_pitch_boundary, \
		release_time_in_seconds, \
		fft_length, \
		output_data_type, \
		method_on_multiple_channels__average_0__peak_1, \
		decibels_of_compression, \
		analysis_frames_per_second, \
		endtime, \
		analysis_sndfile, \
		output_data_format, \
		ouput_sample_rate\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //...SPECTRAL FLUX TRACKER (NOISE METER) ...............\cf2 \
		\cf5 //******************************************************\cf2 \
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		spectral_flux_file = \cf4 "/tmp/sf"\cf2  ;\
\
		plot_output__yes_1__no_0 = 0 ;\
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
		analysis_sndfile = \cf4 "~/mySound.au"\cf2  ;\
\
		\cf5 //........ BEGIN/END TIMES .............................\cf2 \
\
		begintime = 0 ;\
		endtime = 0 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
\
		fft_length = 1024 ;\
		window_type = 2 ;\
		windowsize = 0 ;\
\
		\cf5 // (0 sets windowsize to 2 * FFT (or larger))\cf2 \
\
		\cf5 //........... ANALYSIS CHANNEL(S) .......................\cf2 \
		analysis_channel = 1 ;\
\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		\cf5 //......................................................\cf2 \
\
		method_on_multiple_channels__average_0__peak_1 = 0 ;\
\
		\cf5 //.............   FRAMES ...............................\cf2 \
\
		analysis_frames_per_second = 200 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*************** DETECTION PARAMETERS *****************\cf2 \
		boundary_data_type = 0 ;\
		\cf5 //( 0 = frequency )\cf2 \
		\cf5 //( 1 = octave.pitchclass )\cf2 \
\
		\cf5 //............... BOUNDARIES ............................\cf2 \
\
		low_freq_or_pitch_boundary = 0 ;\
		high_freq_or_pitch_boundary = 22050 ;\
\
		\cf5 //............... WEIGHTING FACTOR .....................\cf2 \
\
		amplitude_weighting__0_off__1_on = 0 ;\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*************** OUTPUT FORMAT ************************\cf2 \
\
\
		\cf5 //................ OUTPUT RATE  ........................\cf2 \
\
		ouput_sample_rate = 1000 ;\
		\cf5 //( for non soundfile data types)\cf2 \
\
		\cf5 //................ OUTPUT FORMAT  ......................\cf2 \
\
		output_data_format = 0 ;\
		\cf5 //( 0: 0-1 amplitude )\cf2 \
		\cf5 //( 1: -96 to -0 decibels )\cf2 \
		\cf5 //( 2: inverted amplitude (1 - amplitude) )\cf2 \
		\cf5 //( 3: inverted decibels (0 - decibels + 96.) )\cf2 \
\
		\cf5 //............... OUTPUT TYPE  .........................\cf2 \
\
\
		output_data_type = 0 ;\
		\cf5 //( 0: ascii )\cf2 \
		\cf5 //( 1: 32-bit floats )\cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //************ ENVELOPE MODIFICATIONS ******************\cf2 \
\
		\cf5 //.......... AMPLITUDE RESPONSE ........................\cf2 \
\
		release_time_in_seconds = 0 ;\
		attack_time_in_seconds = 0 ;\
\
		\cf5 //............ COMPRESSOR ..............................\cf2 \
\
		compression_threshold_in_decibels = -0 ;\
		decibels_of_compression = -0 ;\
\
		\cf5 //............ GATE ....................................\cf2 \
\
		gate_threshold_in_decibels = -200 ;\
\
		\cf5 //............ WARP ....................................\cf2 \
\
		amplitude_envelope_warp = 0 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //========= SCRATCH SPACE ==============================\cf2 \
		\cf5 //======================================================\cf2 \
\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "fluxoid"\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -w"\cf2  ++ window_type ++  \cf4 " -N"\cf2  ++ fft_length ++  \cf4 " -b"\cf2  ++ begintime ++  \cf4 " -C"\cf2  ++ analysis_channel ++ \
			 \cf4 " -A"\cf2  ++ amplitude_weighting__0_off__1_on ++  \cf4 " -l"\cf2  ++ attack_time_in_seconds ++ \
			 \cf4 " -X"\cf2  ++ method_on_multiple_channels__average_0__peak_1 ++  \cf4 " -r"\cf2  ++ ouput_sample_rate ++ \
			 \cf4 " -D"\cf2  ++ analysis_frames_per_second ++  \cf4 " -W"\cf2  ++ amplitude_envelope_warp ++ \
			 \cf4 " -p1"\cf2  ++  \cf4 " -P"\cf2  ++ plot_output__yes_1__no_0 ++  \cf4 " -f"\cf2  ++ low_freq_or_pitch_boundary ++ \
			 \cf4 " -F"\cf2  ++ high_freq_or_pitch_boundary ++  \cf4 " -Q"\cf2  ++ boundary_data_type ++  \cf4 " -G"\cf2  ++ decibels_of_compression ++ \
			 \cf4 " -S"\cf2  ++ gate_threshold_in_decibels ++  \cf4 " -e"\cf2  ++ endtime ++  \cf4 " -T"\cf2  ++ compression_threshold_in_decibels ++ \
			 \cf4 " -q"\cf2  ++ output_data_format ++  \cf4 " -g"\cf2  ++ output_data_type ++  \cf4 " -L"\cf2  ++ release_time_in_seconds ++ \
			 \cf4 " -M"\cf2  ++ windowsize\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ analysis_sndfile ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ spectral_flux_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
fluxoid.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
)\
}