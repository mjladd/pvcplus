\
\
\
		\cf5 //******** IMPULSE RESPONSE TEMPORAL SIGNAL SHAPING ***************\cf2 \
\
		\cf5 // \cf2 \
		\cf5 // For shaping, impulse response input signal amplitudes (i.e. time domain),\cf2 \
		\cf5 // spanning the 0 to -96 dB range, are divided by the dB breakpoint.\cf2 \
		\cf5 // Amplitudes above the breakpoint are shaped by the upper curve index and\cf2 \
		\cf5 // amplitudes below are shaped by the lower. \cf2 \
		\cf5 // The upper amplitudes are mapped into a new range extending from the breakpoint\cf2 \
		\cf5 // amplitude to the peak shaping amplitude.\cf2 \
		\cf5 // With the peak amplitude at 0 (default) and an appropriate breakpoint setting, \cf2 \
		\cf5 // positive upper curve indices can be used to warp the upper values toward the \cf2 \
		\cf5 // breakpoint amplitude, which should suppress early reflections; conversely, \cf2 \
		\cf5 // negative indices will warp values toward the peak shaping amplitude, which \cf2 \
		\cf5 // will accentuate early reflections. \cf2 \
		\cf5 // Additionally, the peak shaping amplitude may be set to any level. When set below\cf2 \
		\cf5 // 0dB and above the breakpoint level, upper values will be compressed. \cf2 \
		\cf5 // Set to levels below the breakpoint amplitude will invert the upper amplitude range\cf2 \
		\cf5 // to span the range from the breakpoint to the lower peak setting, which will \cf2 \
		\cf5 // reduce direct and early reflections as it draws out the reverb tail. \cf2 \
		\cf5 // The lower region functions similarly between base and breakpoint levels, with\cf2 \
		\cf5 // the sign of indices inverted; that is, negative indices for this region will \cf2 \
		\cf5 // warp values toward the break point and, thus, amplify the reverberation, and\cf2 \
		\cf5 // positive indices will warp them toward the base, which will suppress the reverberation\cf2 \
		\cf5 // tail, depending, of course, on where the base level is set.    \cf2 \
\
		impulse_response_shaping_switch__off_0__on_1 = 0 ;\
		peak_shaping_amplitude_in_db = -0 ;\
		\cf5 // (func)\cf2 \
		\cf5 // Set to 0 for off.  \cf2 \
		upper_shaping_curve_index = -3 ;\
		\cf5 // (func)\cf2 \
		\cf5 // Set to 0 for off.\cf2 \
		shaping_breakpoint_in_db = -10 ;\
		\cf5 // (func)\cf2 \
		\cf5 // Any value in -96 to 0 range for off.\cf2 \
		base_shaping_amplitude_in_db = -96 ;\
		\cf5 // (func)\cf2 \
		\cf5 // Any value below breakpoint value for off.\cf2 \
		lower_shaping_curve_index = -2 ;\
		\cf5 // (func)\cf2 \
		\cf5 // Set to 0 for off.\cf2 \
\
\
\
\
		\cf5 //********** AMPLITUDE STATISTICS ********************** \cf2 \
