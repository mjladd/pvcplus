\
		convolution_multichannel_output_mode__standard_0__alternate_1 = 1 ;\
		\cf5 // (Should be 1 for mono-to-multi-channel convolution.)\cf2 \
		\cf5 //\cf2 \
		\cf5 // *Standard-output-mode* matches the input audio file channels \cf2 \
		\cf5 // specified above (either one or all) with the channels of the \cf2 \
		\cf5 // impulse analysis file, loop assigning the (one or more) \cf2 \
		\cf5 // impulse channels to the input audio channels, as needed. \cf2 \
		\cf5 //\cf2 \
		\cf5 // *Alternate-output-mode* offers the step-saving option of\cf2 \
		\cf5 // convolving a single specified input channel or monophonic \cf2 \
		\cf5 // audio file with all the channels of the impulse analysis file \cf2 \
		\cf5 // in a multi-channel output file of the same number of channels.\cf2 \
		\cf5 // The selected channel is through the output channel parameter \cf2 \
		\cf5 // (see above), which *must* be selected (i.e. cannot be 0). \cf2 \
		\cf5 //\cf2 \
		\cf5 // Impulse analysis channels may be initially limited/selected by  \cf2 \
		\cf5 // specifying one or more channels in the impulse response \cf2 \
		\cf5 // analysis stage (see beginning of script) or by selecting one \cf2 \
		\cf5 // channel from the resulting impulse analysis file (see below), \cf2 \
		\cf5 // for subsequent use in irconvolver.\cf2 \
		\cf5 //\cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
\
		\cf5 // IMPULSE FREQ RESPONSE FILE\cf2 \
		\cf5 //impulse_frequency_response_file=~/Impulse_Response_Data_File\cf2 \
\
		impulse_channel = 0 ;\
		\cf5 // (Should be 0 for mono-to-multi-channel convolution.)\cf2 \
