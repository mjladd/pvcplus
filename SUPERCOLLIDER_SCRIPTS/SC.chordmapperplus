\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
\
		window_type = 8 ;\
		windowsize = 0 ;\
		\cf5 // (0 sets windowsize to 2 * FFT (or larger))\cf2 \
\
		frames_per_second = 1000 ;\
\
		\cf5 // For inexplicable reasons, it is best to set the frame rate\cf2 \
		\cf5 // to a value >=  the frame rate used in the analysis.\cf2 \
		\cf5 // Lesser frame rates create loss of amplitude and phasiness.\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** RESYNTHESIS PARAMETERS ***************************\cf2 \
\
\
		\cf5 //........... ANALYSIS INPUT CHANNEL(S) .......................\cf2 \
\
		input_channel = 1 ;\
\
		\cf5 // Channels are numbered from 1-maximum.\cf2 \
		\cf5 // 0 designates all channels, repeated in order as needed for \cf2 \
		\cf5 // tone output channels, as specified in tone parameter field 23. \cf2 \
\
		\cf5 //........... OUTPUT DURATION .........................\cf2 \
\
		output_duration = 0 ;\
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		master_gain_in_decibels = 0 ;\
\
		\cf5 //.............OSCIL THRESHOLD ........................\cf2 \
\
		oscillator_resynthesis_threshold_in_db = -96 ;\
\
		\cf5 //****************** MODIFICATIONS *********************\cf2 \
\
\
		\cf5 //********** SOURCE ************************************\cf2 \
		\cf5 // The analysis source sound may be included with the \cf2 \
		\cf5 // tones and noise specified below; modifications are \cf2 \
		\cf5 // limited to gain, frequency shift, and pitch transposition. \cf2 \
\
		source__off_0__on_1 = 0 ;\
\
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
		source_gain_in_db = -0 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		source_frequency_shift = 0 ;\
		source_pitch_transposition_in_semitones = 0 ;\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //**************** DATA TIME **************************\cf2 \
\
		time_point_origin = 0.0 ;\
\
		\cf5 //....... AUTOMATIC VIBRATO PERIODS DETECTION AND RANDOMIZED SELECTION ..............\cf2 \
\
		use_specified_time_boundaries_0__detected_vibrato_periods_1 = 0 ;\
\
\
		\cf5 // When set to 1, a fundamental pitch trajectory analysis is\cf2 \
		\cf5 // performed on the data in order to identify vibrato pitch periods, which\cf2 \
		\cf5 // are used to construct loop window time boundaries. If a sufficient number \cf2 \
		\cf5 // of consecutive periods of similar duration are found, \cf2 \
		\cf5 // the data is used to make new time boundaries for each wrap or fold loop\cf2 \
		\cf5 // segment. If suitable periods are not found, synthesis is aborted; should this happen,\cf2 \
		\cf5 // set above to use time boundaries. \cf2 \
\
		fundamental_frequency_for_vibrato_periods_detection = 70 ;\
\
		\cf5 // For vibrato periods detection, an approximate fundamental frequency \cf2 \
		\cf5 // must be specified. The frequency is used to construct a half octave bandwidth \cf2 \
		\cf5 // pitch track from which vibrato periods are then identified. Values of 12 or less are \cf2 \
		\cf5 // treated as octave.pitchclass.  \cf2 \
\
		rate_multiplier = 1.0 ;\
\
		\cf5 // Rate Multiplier Modes:\cf2 \
		\cf5 //\cf2 \
		\cf5 // Seconds: \cf2 \
		\cf5 // Rate input value or function scales the output time against the time of original sound.\cf2 \
		\cf5 //\cf2 \
		\cf5 // Vibrato Periods:\cf2 \
		\cf5 // Rate input value or function scales time against the duration of the current vibrato period. \cf2 \
		\cf5 // Onset and release stages, having no vibrato periods, use the average vibrato period duration. \cf2 \
		\cf5 // Use of vibrato periods requires successful detection of useable vibrato periods; failure will abort \cf2 \
		\cf5 // synthesis.\cf2 \
\
\
\
		vibrato_period_durations__mechanical_0__natural_1 = 0 ;\
\
		\cf5 //\cf2 \
		\cf5 // When rate multiplier units are set to vibrato periods, time is scaled against either the\cf2 \
		\cf5 // current period length, the average period length, or a normalized proportion of each. \cf2 \
		\cf5 // Scaling time against the current period results in nearly identical length periods--i.e. mechanically \cf2 \
		\cf5 // precise periods; scaled against the average duration preserves the original variance of those \cf2 \
		\cf5 // identified periods--i.e. naturally varying periods. Values between 0 and 1 give respective proportions\cf2 \
		\cf5 // of each. \cf2 \
\
		vibrato_period_duration_deviation_threshold_as_proportion = 0.1 ;\
		\cf5 //\cf2 \
		\cf5 // Identified vibrato periods are accepted or rejected based on the duration\cf2 \
		\cf5 // deviation threshold; the deviation threshold represents the acceptable proportional\cf2 \
		\cf5 // variance of the median duration, above or below. \cf2 \
\
\
\
		\cf5 //........... RATE-CORRELATED ADJUSTMENTS ...........\cf2 \
\
		rate_correlated_force_suppression_switch__off_0__on_1 = 0 ;\
\
		\cf5 // Switched on, playback rate multipliers less than 1 attenuate\cf2 \
		\cf5 // force level while adjusting median stasis levels, in both tone and noise,\cf2 \
		\cf5 // to compensate for the change in amplitude. A rate multiplier of\cf2 \
		\cf5 // 0 (stationary time) neutralizes all force, resulting in a static, stasis\cf2 \
		\cf5 // median sound, adjusted in level to correspond to the original force level.\cf2 \
		\cf5 // Recommended for rate multipliers of less than .25. \cf2 \
\
		rate_correlated_noise_level_control_in_db = -0 ;\
		rate_correlated_tone_level_control_in_db = -0 ;\
\
\
		\cf5 // The principal purpose of this parameter is to allow adjustment of the noise level \cf2 \
		\cf5 // as the rate multiplier approaches 1 and the overall sound becomes static as a result of force\cf2 \
		\cf5 // suppression. (See Suppression Switch above.)\cf2 \
		\cf5 // The amplitude of Noise/Residue banks are attenuated or gained in correlation with reduction in the \cf2 \
		\cf5 // rate multiplier. A rate multiplier of 0 results in full noise attenuation/gain for the specified\cf2 \
		\cf5 // level; a rate multiplier of 1 or greater produces no attenuation of noise. \cf2 \
		\cf5 // Set to 0 to bypass.\cf2 \
\
\
		rate_correlated_randomization_switch__off_0__on_1 = 1 ;\
		\cf5 // Switched on, playback rate multipliers less than 1 introduce \cf2 \
		\cf5 // rate-correlated amplitude and frequency randomization of \cf2 \
		\cf5 // noise/residue bins; rate of 0 produces full randomization and rates\cf2 \
		\cf5 // of 1 or greater introduce no randomization. Use to break up static \cf2 \
		\cf5 // noise re-synthesis produced by slow to zero rates.\cf2 \
\
\
		\cf5 //........... TIME BOUNDARIES AND SAMPLER LOOP MODE ..............\cf2 \
\
		\cf5 // The low/high data time boundaries serve as either auto-stop\cf2 \
		\cf5 // boundaries that terminate synthesis at the crossing of a \cf2 \
		\cf5 // data time boundary or as sampler loop points to which can \cf2 \
		\cf5 // be added pre-loop and post-loop onset and release segments. \cf2 \
\
		lower_time_boundary = 0 ;\
		upper_time_boundary = -1 ;\
\
\
		\cf5 // -1 for low defaults to 0.0 and for high to analysis file duration.\cf2 \
\
\
\
		\cf5 //.....AUTOSTOP ........................................\cf2 \
\
		mode__sampler_loop_0__autostop_1 = 1 ;\
\
		\cf5 // In autostop mode, synthesis terminates with crossing of \cf2 \
		\cf5 // a time boundary. In sampler loop mode, time boundaries \cf2 \
		\cf5 // function as sampler loop points. \cf2 \
\
\
		\cf5 //.....LOOP MODE .......................................\cf2 \
\
		sampler_loop_mode__wrap_0__fold_1__clip_2 = 1 ;\
\
		\cf5 // In Sampler Loop Mode, all timepoints are constrained to\cf2 \
		\cf5 // region between boundaries using the specified method.  \cf2 \
		\cf5 // 0: Wrap time into loop range. (/////)\cf2 \
		\cf5 // 1: Fold time into loop range. (/\\/\\/\\/\\)\cf2 \
		\cf5 // 2: Clip or limit time to the nearest boundary. (\\____)\cf2 \
\
		onset_and_release_segment_mode__off_0__on_1__onset_only_2 = 0 ;\
\
		\cf5 // Setting onset/release mode in Sampler Mode causes looping\cf2 \
		\cf5 // to be preceded by a pre-loop/onset and a post-loop/release \cf2 \
		\cf5 // segment. The data time origin is initialized to 0.0 and \cf2 \
		\cf5 // progresses according to data time controls. The first entrance\cf2 \
		\cf5 // into the loop region triggers loop mode, which is maintained\cf2 \
		\cf5 // until trigger of the release segment. The release segment\cf2 \
		\cf5 // progresses from the current loop point to the analysis data\cf2 \
		\cf5 // end time, conforming to the data time rate control and specified\cf2 \
		\cf5 // synthesis duration. If vibrato periods are being used, then \cf2 \
		\cf5 // data time jumps upon to the end of the vibrato period section\cf2 \
		\cf5 // at the next vibrato period boundary. In onset_only mode, the release\cf2 \
		\cf5 // segment is prevented, leaving the data in loop mode.\cf2 \
\
		normalize_loop_amplitudes__off_0__on_1 = 0 ;\
\
		\cf5 // When set to 1, amplitudes in loop range are normalized to peak \cf2 \
		\cf5 // amplitude of low/high boundary frames. Onset and release \cf2 \
		\cf5 // segments are ramped in and out of loop range gain change \cf2 \
		\cf5 // as needed.  \cf2 \
\
		loop_smooth_time_in_seconds = 0.2 ;\
\
		\cf5 // Loop junctures for wrapped and folded loops are smoothed\cf2 \
		\cf5 // with a lowpass filter, the smooth time of which is ramped \cf2 \
		\cf5 // up and down before and after the loop juncture points to \cf2 \
		\cf5 // smooth any sudden change in amplitude and frequency values.\cf2 \
		\cf5 // Too long a smooth time can introduce a bump something \cf2 \
		\cf5 // like the one being smoothed. \cf2 \
		\cf5 // Try .1 to .4. \cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 // ************* SYNTHETIC VIBRATO *********************\cf2 \
		\cf5 //======================================================\cf2 \
		\cf5 // For straight tones, a synthetic vibrato is available. \cf2 \
		\cf5 // The vibrato is achieved through modulation of the \cf2 \
		\cf5 // force level introduced into noise and tone components. \cf2 \
		\cf5 // An on/off switch is included for each tone component. \cf2 \
\
		synthetic_vibrato_rate = 6 ;\
\
		synthetic_vibrato_randomization_prop = 0 ;\
\
		\cf5 // 0: no randomization\cf2 \
		\cf5 // 1: full randomization\cf2 \
\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //********** NOISE OR RESIDUAL SIGNAL ******************\cf2 \
		\cf5 //======================================================\cf2 \
		\cf5 // Remaining data lines, not selected by tones, are collected \cf2 \
		\cf5 // together into a bank and identified with analysis noise or \cf2 \
		\cf5 // residue. A separate copy of the noise bank is made for each \cf2 \
		\cf5 // tone data line for use in the re-synthesis of that tone line.\cf2 \
\
		noise_band_limit_level_in_db = -0 ;\
		\cf5 //  Try -40 to -60\cf2 \
\
		\cf5 // From frame-to-frame, noise bank channel amplitudes \cf2 \
		\cf5 // are limited to the limit level specified above; limit levels \cf2 \
		\cf5 // are set relative to the peak average amplitudes of the adjoining \cf2 \
		\cf5 // tone band regions.\cf2 \
\
		noise_band_limit_level_rolloff_in_db = -0 ;\
		\cf5 // 0 = off, try -10 to -40\cf2 \
\
\
		\cf5 // The amplitude of noise band channels may be progressively rolled\cf2 \
		\cf5 // off or on, beginning at their tone partial border edges and moving to \cf2 \
		\cf5 // their center; rolloff is linear beginning at the limit level, \cf2 \
		\cf5 // with each channel step toward the center accumulating more of \cf2 \
		\cf5 // the specified rolloff.  \cf2 \
		\cf5 //\cf2 \
		\cf5 // Negative rolloff values can be used to create a trough-like suppression of\cf2 \
		\cf5 // mid-partial noise channels. Suppressing the mid noise band channels while preserving\cf2 \
		\cf5 // channels adjacent to the partial can add roughness to the partial\cf2 \
		\cf5 // band; they may also be used in place of the partial, once it is \cf2 \
		\cf5 // appropriately attenuated and the noise band amplified.\cf2 \
		\cf5 //\cf2 \
		\cf5 // The trough-like attenuation of noise bands can be experimentally \cf2 \
		\cf5 // inverted to make a peak-shaped noise band by first expanding \cf2 \
		\cf5 // the noise band width and then using a low limit level with a \cf2 \
		\cf5 // positive rolloff. For this application, try a tone bandwidth of \cf2 \
		\cf5 // .01, a limit level of -90 or less, a positive rolloff (i.e. roll-on) \cf2 \
		\cf5 // values of 0 to 20.\cf2 \
\
		noise_band_frequency_change_suppression_threshold = 0 ;\
\
		\cf5 // Try .3 to .6\cf2 \
		\cf5 // The amplitude of pitched components occurring in the noise bands\cf2 \
		\cf5 // may be reduced to some extent by suppression channel amplitude \cf2 \
		\cf5 // in conjunction with the channel's frequency stasis. The \cf2 \
		\cf5 // threshold, below which channels are suppressed, is a (0-1) proportion\cf2 \
		\cf5 // of one channel bandwidth traversed over 1/10th of a second--the \cf2 \
		\cf5 // channel bandwidths is equal to the FFT analysis fundamental.\cf2 \
		\cf5 // With 0 representing no frequency change, the transition from\cf2 \
		\cf5 // static to more noise-like frequency movement corresponds to \cf2 \
		\cf5 // about .1 to .3.\cf2 \
		\cf5 //\cf2 \
		\cf5 // This control is a relatively experimental feature, although it\cf2 \
		\cf5 // might be used to remove pitched residue components or to accentuate\cf2 \
		\cf5 // noise band roughness through selection of more transient frequency\cf2 \
		\cf5 // components. \cf2 \
\
		frequency_stasis_suppression_decibels = 0 ;\
\
		\cf5 // Try -50 to -100\cf2 \
		\cf5 // Suppression decibels determine degree of channel suppression,\cf2 \
		\cf5 // applied according to the proportion of frequency change over the \cf2 \
		\cf5 // suppression threshold. 0 is off. \cf2 \
\
		frequency_stasis_suppression_threshold_rise_response_time_in_seconds = 0.0 ;\
\
		\cf5 // Try .1 to 1.0\cf2 \
		\cf5 // Increasing response times slow the rate of each channel's measured \cf2 \
		\cf5 // increase in frequency change, thus allowing control of roughness\cf2 \
		\cf5 // by lengthening the effect of frequency stasis.\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //**************** TONES *******************************\cf2 \
		\cf5 //======================================================\cf2 \
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		gain_in_db = 0 ;\
\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		frequency_shift = 0 ;\
		pitch_transposition_in_semitones = 0 ;\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 // . . . TONE SOURCE POINT ADJUSTMENT . . . . . . . . . .\cf2 \
		\cf5 //======================================================\cf2 \
\
		tone_source_point_analysis_adjustment_switch__off_0__on_1 = 0 ;\
\
		\cf5 // Switched on, the control above causes the specified \cf2 \
		\cf5 // Tone Source Points to be refined, through analysis, to \cf2 \
		\cf5 // a frequency lying between four semitones above and below\cf2 \
		\cf5 // the specified tone pitch or frequency.\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 // . . . PARTIAL FORMANT AUTOMATED ADJUSTMENT . \cf2 \
		\cf5 //======================================================\cf2 \
\
		partial_formant_auto_adjust__off_0__on_1 = 0 ;\
		\cf5 //\cf2 \
		\cf5 // The partial formant auto adjust feature causes the user-specified\cf2 \
		\cf5 // bandwidth (parameter field 6) to be independently modified at \cf2 \
		\cf5 // each partial formant in accord with the decibel stopband\cf2 \
		\cf5 // levels detected in the average spectrum relative to each \cf2 \
		\cf5 // partial's peak amplitude. \cf2 \
\
		partial_formant_auto_adjust_stopband_level_in_db = -30 ;\
		\cf5 //\cf2 \
		\cf5 // Try -20 to -40\cf2 \
\
		partial_formant_auto_adjust_inclusion_threshold_in_db = -96 ;\
\
\
		\cf5 //\cf2 \
		\cf5 // In auto adjust mode, partial formants whose peak dB falls \cf2 \
		\cf5 // below the threshold are omitted and, therefore, added to the \cf2 \
		\cf5 // noise/residue component. Setting high thresholds (-10 to -40)\cf2 \
		\cf5 // can make an interesting residue component as higher\cf2 \
		\cf5 // low gain partials are combined in with noise bins.  \cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 // . . . . ANALYSIS DATA FILE . . . . .  . . . . . . . . \cf2 \
		\cf5 //======================================================\cf2 \
\
		input_analysis_file = \cf4 "~/pvanalysis"\cf2  ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 // . . . . TONES DATA FILE . . . . . . . . . . . . . . . \cf2 \
		\cf5 //======================================================\cf2 \
\
		data_file = \cf4 "/tmp/data"\cf2  ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //***** PARAMETER FIELDS OF DATA FILE "TONES" **********\cf2 \
		\cf5 // ( Every 22 values in the data file represents a tone. )\cf2 \
		\cf5 // ( The values fill parameter fields as seen below. )\cf2 \
		\cf5 //\cf2 \
		\cf5 // 1:  Tone Source Point, in frequency or octave.pitchclass. \cf2 \
		\cf5 //	Values < 13 are treated as octave.pitchclass. \cf2 \
		\cf5 // 2: Tone Transpose Point, in frequency or octave.pitchclass. (func)\cf2 \
