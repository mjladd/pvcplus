{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf0 (\cf2 \
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  tvfilter = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		input_sound_file, \
		filter_attack_time_in_seconds, \
		sampler_loop_mode__wrap_0__fold_1__clip_2, \
		filter_low_shelf_eq_gain_in_decibels, \
		normalize_to__input_sound_0__filter_1, \
		window_type, \
		begintime, \
		p_change_select__source_only_0__both_source_and_filter_1, \
		filter_low_shelf_eq_frequency, \
		fft_length, \
		filter_source_db_floor, \
		filter_transposition_in_semitones, \
		release_time_in_seconds, \
		filter_high_shelf_eq_frequency, \
		amplitude_statistics_time_interval, \
		peaks_response_smooth_factor_bw__in_frequency_or_octaves, \
		loop_smooth_time_in_seconds, \
		input_analysis_file, \
		filter_high_shelf_eq_gain_in_decibels, \
		endtime, \
		frequency_shift, \
		onset_and_release_segment_mode__off_0__on_1, \
		auto_output_sound_file_play__repetitions, \
		print_amplitude_statistics_0_no__1_yes, \
		filter_upper_time_boundary, \
		oscillator_resynthesis_threshold_in_db, \
		analysis_channel_1_to_max__0_all, \
		filter_rate_multiplier, \
		frame_normalization_decibel_limit, \
		resynthesis_channel_1_to_max__0_all, \
		filter_type__pass_0__rejectmode_1__rejectmode_2, \
		filter_spectrum_compression_threshold_in_decibels, \
		filter_time_point_origin, \
		windowsize, \
		pitch_transposition_in_semitones, \
		gain_in_decibels, \
		filter_lower_time_boundary, \
		frames_per_second, \
		attack_time_in_seconds, \
		normalize_loop_amplitudes__off_0__on_1, \
		filter_spectrum_decibels_of_compression, \
		filter_shift, \
		output_file, \
		time_expansion_contraction_factor, \
		mode__sampler_loop_0__autostop_1, \
		filter_spectrum_warpshape_index, \
		rescale_level_in_decibels, \
		filter_release_time_in_seconds\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //* ANALYSIS DRIVEN,TIME-VARYING PHASE VOCODER FILTERING\cf2 \
		\cf5 //******************************************************\cf2 \
\
\
		output_file = \cf4 "/tmp/output.au"\cf2  ;\
\
		\cf5 // The following may be used to copy a formatted\cf2 \
		\cf5 // sound file into the output location listed above.   \cf2 \
\
		\cf5 //cp ~/32bit.BLANK.au $output_file\cf2 \
\
		\cf5 //...............AUTO-PLAY OF OUTPUT FILE...............\cf2 \
		auto_output_sound_file_play__repetitions = 0 ;\
		\cf5 //(-2 = interactive: Play once, then prompts for more.)\cf2 \
		\cf5 //(-1 = interactive: Prompt for each play of file.)\cf2 \
		\cf5 //( 0 = off)\cf2 \
		\cf5 //( 1 or greater = Auto-repeat for specified repetitions.)\cf2 \
\
		\cf5 //................ RESCALE .............................\cf2 \
\
		rescale_level_in_decibels = -0 ;\
		\cf5 //(-96 to 0 dB. )\cf2 \
		\cf5 //(Set to 1 to rescale to peak of input file.)\cf2 \
		\cf5 //(Set to 2 to bypass rescale.)\cf2 \
\
\
		input_analysis_file = \cf4 "~/pvanalysis"\cf2  ;\
\
		input_sound_file = \cf4 "~/ridecymbal.NF.aiff"\cf2  ;\
\
\
		\cf5 //******** BEGIN/END TIMES *****************************\cf2 \
		\cf5 // (0 end time defaults to end of file)\cf2 \
		begintime = 0.0 ;\
		endtime = 0 ;\
\
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
		fft_length = 4096 ;\
		window_type = 8 ;\
		windowsize = 0 ;\
\
		frames_per_second = 200 ;\
		time_expansion_contraction_factor = 1 ;\
\
		\cf5 //**** OUTPUT CHANNEL(S) *******************************\cf2 \
		resynthesis_channel_1_to_max__0_all = 0 ;\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		oscillator_resynthesis_threshold_in_db = -96 ;\
\
		\cf5 //****** DYNAMIC PARAMETERS ****************************\cf2 \
		gain_in_decibels = 0 ;\
		frequency_shift = -0 ;\
		pitch_transposition_in_semitones = 0 ;\
\
		p_change_select__source_only_0__both_source_and_filter_1 = 0 ;\
		\cf5 //((0) applies pitch changes before filtering, (1) after)\cf2 \
\
		\cf5 //************ENVELOPE RESPONSE **********************\cf2 \
		release_time_in_seconds = 0 ;\
		attack_time_in_seconds = 0 ;\
\
		\cf5 //********\cf2 \
		\cf5 //************* FILTER *******************************\cf2 \
		\cf5 //********\cf2 \
		\cf5 //**** ANALYSIS CHANNEL(S) **\cf2 \
		analysis_channel_1_to_max__0_all = 1 ;\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
\
		filter_type__pass_0__rejectmode_1__rejectmode_2 = 0 ;\
		\cf5 //type 0 passes \cf2 \
		\cf5 // type 1 inverts response to 0dB\cf2 \
		\cf5 // type 2 inverts response to frame peak\cf2 \
\
		filter_transposition_in_semitones = 0 ;\
		filter_shift = 0 ;\
		filter_source_db_floor = -96 ;\
\
\
\
		filter_spectrum_warpshape_index = 0 ;\
\
\
		\cf5 //************* FILTER TIME **************************\cf2 \
		filter_time_point_origin = 0 ;\
		filter_rate_multiplier = 1 ;\
\
\
		\cf5 //.. FILTER TIME BOUNDARIES AND SAMPLER LOOP MODE ..............\cf2 \
\
		\cf5 // The low/high data time boundaries serve as either auto-stop\cf2 \
		\cf5 // boundaries that terminate synthesis at the crossing of a \cf2 \
		\cf5 // data time boundary or as sampler loop points to which can \cf2 \
		\cf5 // be added pre-loop and post-loop onset and release segments. \cf2 \
\
\
		filter_lower_time_boundary = -1 ;\
		filter_upper_time_boundary = -1 ;\
\
		\cf5 // -1 for low defaults to 0.0 and for high to analysis file duration.\cf2 \
\
\
		mode__sampler_loop_0__autostop_1 = 1 ;\
\
		\cf5 // In autostop mode, synthesis terminates with crossing of \cf2 \
		\cf5 // a time boundary. In sampler loop mode, time boundaries \cf2 \
		\cf5 // function as sampler loop points. \cf2 \
\
		sampler_loop_mode__wrap_0__fold_1__clip_2 = 0 ;\
\
		\cf5 // In Sampler Loop Mode, all timepoints are constrained to\cf2 \
		\cf5 // region between boundaries using the specified method.  \cf2 \
		\cf5 // 0: Wrap time into loop range. (/////)\cf2 \
		\cf5 // 1: Fold time into loop range. (/\\/\\/\\/\\)\cf2 \
		\cf5 // 2: Clip or limit time to the nearest boundary. (\\____)\cf2 \
\
		onset_and_release_segment_mode__off_0__on_1 = 0 ;\
\
		\cf5 // Setting onset/release mode in Sampler Mode causes looping\cf2 \
		\cf5 // to be preceded by a pre-loop/onset and post-loop/release \cf2 \
		\cf5 // segments. The data time origin is initialized to 0.0 and \cf2 \
		\cf5 // progresses according to data time controls. The first entrance\cf2 \
		\cf5 // into the loop region triggers loop mode, which is maintained\cf2 \
		\cf5 // until trigger of the release segment. The release segment\cf2 \
		\cf5 // progresses from the current loop point to the analysis data\cf2 \
		\cf5 // end time, conforming to the data time rate control and specified\cf2 \
		\cf5 // synthesis duration. \cf2 \
\
		normalize_loop_amplitudes__off_0__on_1 = 0 ;\
\
		\cf5 // Set to 1, amplitudes in loop range are normalized to peak \cf2 \
		\cf5 // amplitude of low/high boundary frames. Onset and release \cf2 \
		\cf5 // segments are ramped in and out of loop range gain change \cf2 \
		\cf5 // as needed.  \cf2 \
\
		loop_smooth_time_in_seconds = 0.0 ;\
\
		\cf5 // Loop junctures for wrapped and folded loops are smoothed\cf2 \
		\cf5 // with a lowpass filter, the smooth time of which is ramped \cf2 \
		\cf5 // up and down before and after the loop juncture points to \cf2 \
		\cf5 // smooth any sudden change in amplitude and frequency values.\cf2 \
\
\
\
		\cf5 //***** FILTER ENVELOPE RESPONSE **********************\cf2 \
		filter_attack_time_in_seconds = 0.0 ;\
		filter_release_time_in_seconds = 0.0 ;\
\
\
\
		\cf5 //********** FILTER SPECTRUM COMPRESSION **************\cf2 \
		filter_spectrum_compression_threshold_in_decibels = -0 ;\
		filter_spectrum_decibels_of_compression = -0 ;\
\
\
		\cf5 //******* FILTER PRE-PROCESSING LOW/HIGH SHELF EQ *****\cf2 \
		filter_low_shelf_eq_gain_in_decibels = -0 ;\
		filter_low_shelf_eq_frequency = 200 ;\
\
		filter_high_shelf_eq_gain_in_decibels = 0 ;\
		filter_high_shelf_eq_frequency = 4000 ;\
\
\
		\cf5 //******* FILTER RESPONSE SMOOTHING ******************\cf2 \
		peaks_response_smooth_factor_bw__in_frequency_or_octaves = 0 ;\
\
		\cf5 // A band of the specified width is slid across the spectrum\cf2 \
		\cf5 // and used to create average values for the band's center\cf2 \
		\cf5 // frequency out of the frequencies encompassed by each band. \cf2 \
		\cf5 // Negative values are treated as positive octave bandwidths, \cf2 \
		\cf5 // otherwise units are in frequency. Set to 0 to bypass. \cf2 \
\
\
		\cf5 //********* FRAME NORMALIZATION ******************************\cf2 \
\
		frame_normalization_decibel_limit = 0 ;\
		normalize_to__input_sound_0__filter_1 = 1 ;\
\
\
		\cf5 // Scale the amplitudes of each output frame against either the input-sound \cf2 \
		\cf5 // or the analysis filter. Scaling is produced using a ratio formed\cf2 \
		\cf5 // from the sum of the respective input-sound or filter amplitudes\cf2 \
		\cf5 // over the sum of the output frame amplitudes limited by the decibel limit. \cf2 \
		\cf5 // 0 prevents normalization; increase limit as necessary to as much as 200. \cf2 \
\
\
\
\
		\cf5 //********** AMPLITUDE STATISTICS ******************** \cf2 \
		print_amplitude_statistics_0_no__1_yes = 1 ;\
		amplitude_statistics_time_interval = 1 ;\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "tvfilter "\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -j"\cf2  ++ normalize_loop_amplitudes__off_0__on_1 ++  \cf4 " -b"\cf2  ++ begintime ++ \
			 \cf4 " -C"\cf2  ++ resynthesis_channel_1_to_max__0_all ++  \cf4 " -n"\cf2  ++ frame_normalization_decibel_limit ++ \
			 \cf4 " -X"\cf2  ++ filter_high_shelf_eq_gain_in_decibels ++  \cf4 " -_"\cf2  ++ auto_output_sound_file_play__repetitions ++ \
			 \cf4 " -D"\cf2  ++ frames_per_second ++  \cf4 " -H"\cf2  ++ filter_low_shelf_eq_gain_in_decibels ++ \
			 \cf4 " -k"\cf2  ++ loop_smooth_time_in_seconds ++  \cf4 " -P"\cf2  ++ pitch_transposition_in_semitones ++ \
			 \cf4 " -f"\cf2  ++ peaks_response_smooth_factor_bw__in_frequency_or_octaves ++  \cf4 " -F"\cf2  ++ input_analysis_file ++ \
			 \cf4 " -Y"\cf2  ++ filter_rate_multiplier ++  \cf4 " -i"\cf2  ++ amplitude_statistics_time_interval ++ \
			 \cf4 " -e"\cf2  ++ endtime ++  \cf4 " -I"\cf2  ++ time_expansion_contraction_factor ++  \cf4 " -T"\cf2  ++ filter_transposition_in_semitones ++ \
			 \cf4 " -q"\cf2  ++ filter_type__pass_0__rejectmode_1__rejectmode_2 ++  \cf4 " -z"\cf2  ++ filter_attack_time_in_seconds ++ \
			 \cf4 " -R"\cf2  ++ filter_high_shelf_eq_frequency ++  \cf4 " -w"\cf2  ++ window_type ++  \cf4 " -N"\cf2  ++ fft_length ++ \
			 \cf4 " -A"\cf2  ++ gain_in_decibels ++  \cf4 " -l"\cf2  ++ attack_time_in_seconds ++  \cf4 " -d"\cf2  ++ mode__sampler_loop_0__autostop_1 ++ \
			 \cf4 " -r"\cf2  ++ onset_and_release_segment_mode__off_0__on_1 ++  \cf4 " -W"\cf2  ++ filter_spectrum_warpshape_index ++ \
			 \cf4 " -p"\cf2  ++ print_amplitude_statistics_0_no__1_yes ++  \cf4 " -K"\cf2  ++ analysis_channel_1_to_max__0_all ++ \
			 \cf4 " -v"\cf2  ++ normalize_to__input_sound_0__filter_1 ++  \cf4 " -a"\cf2  ++ frequency_shift ++ \
			 \cf4 " -="\cf2  ++ rescale_level_in_decibels ++  \cf4 " -G"\cf2  ++ filter_upper_time_boundary ++ \
			 \cf4 " -Q"\cf2  ++ filter_time_point_origin ++  \cf4 " -m"\cf2  ++ filter_low_shelf_eq_frequency ++ \
			 \cf4 " -S"\cf2  ++ filter_source_db_floor ++  \cf4 " -Z"\cf2  ++ filter_release_time_in_seconds ++ \
			 \cf4 " -B"\cf2  ++ p_change_select__source_only_0__both_source_and_filter_1 ++  \cf4 " -V"\cf2  ++ filter_shift ++ \
			 \cf4 " -c"\cf2  ++ filter_spectrum_decibels_of_compression ++  \cf4 " -g"\cf2  ++ filter_lower_time_boundary ++ \
			 \cf4 " -o"\cf2  ++ sampler_loop_mode__wrap_0__fold_1__clip_2 ++  \cf4 " -E"\cf2  ++ filter_spectrum_compression_threshold_in_decibels ++ \
			 \cf4 " -L"\cf2  ++ release_time_in_seconds ++  \cf4 " -M"\cf2  ++ windowsize ++  \cf4 " -t"\cf2  ++ oscillator_resynthesis_threshold_in_db\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ input_sound_file ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
tvfilter.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
\cf0 )\
}