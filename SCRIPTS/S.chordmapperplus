#!/bin/sh
#******************************************************
#************** CHORDMAPPERPLUS ***********************
#******************************************************

#******************** OUTPUT **************************

output_file=/tmp/output.au

# The following may be used to copy a formatted
# sound file into the output location listed above.   

#cp ~/32bit.BLANK.au $output_file


#......................................................

#...............AUTO-PLAY OF OUTPUT FILE...............
auto_output_sound_file_play__repetitions=0
#(-2 = interactive: (Play once, then prompt for more.)
#(-1 = interactive: (Prompt for each play of file.)
#( 0 = off)
#( 1 or greater = Auto-repeat for specified repetitions.)

#................ RESCALE .............................

rescale_level_in_decibels=0
# -96 to 0 dB.
# Set to 2 to bypass rescale.
# Do not use 1 (i.e. rescale to original level) as 
#     analysis file levels are very low.


#======================================================
#*** ANALYSIS PARAMETERS ******************************

window_type=8
windowsize=0
# (0 sets windowsize to 2 * FFT (or larger))

frames_per_second=1000

#( For inexplicable reasons, it is best to set the frame rate
# to a value >=  the frame rate used in the analysis.
# Lesser frame rates create loss of amplitude and phasiness.)

#======================================================
#*** RESYNTHESIS PARAMETERS ***************************


#........... ANALYSIS INPUT CHANNEL(S) .......................

input_channel=1

# Channels are numbered from 1-maximum.
# 0 designates all channels, repeated in order as needed for 
# tone output channels, as specified in tone parameter field 23. 

#........... OUTPUT DURATION .........................

output_duration=0

#.................. DECIBELS ..........................

MASTER_gain_in_decibels=0

#.............OSCIL THRESHOLD ........................

oscillator_resynthesis_threshold_in_dB=-96

#****************** MODIFICATIONS *********************


#********** SOURCE ************************************
# The analysis source sound may be included with the 
# tones and noise specified below; modifications are 
# limited to gain, frequency shift, and pitch transposition. 

SOURCE__Off_0__On_1=0


#.................. DECIBELS ..........................
SOURCE_gain_in_dB=-0

#.................. PITCH .............................

SOURCE_frequency_shift=0
SOURCE_pitch_transposition_in_semitones=0


#======================================================
#**************** DATA TIME **************************

time_point_origin=0.0

#....... AUTOMATIC VIBRATO PERIODS DETECTION AND RANDOMIZED SELECTION ..............

Use_Specified_Time_Boundaries_0__Detected_Vibrato_Periods_1=0


# When set to 1, a fundamental pitch trajectory analysis is
# performed on the data in order to identify vibrato pitch periods, which
# are used to construct loop window time boundaries. If a sufficient number 
# of consecutive periods of similar duration are found, 
# the data is used to make new time boundaries for each wrap or fold loop
# segment. If suitable periods are not found, synthesis is aborted; should this happen,
# set above to use time boundaries. 

Fundamental_Frequency_for_Vibrato_Periods_Detection=70

# For vibrato periods detection, an approximate fundamental frequency 
# must be specified. The frequency is used to construct a half octave bandwidth 
# pitch track from which vibrato periods are then identified. Values of 12 or less are 
# treated as octave.pitchclass.  

rate_multiplier=1.0

# Rate Multiplier Modes:
#
# Seconds: 
# Rate input value or function scales the output time against the time of original sound.
#
# Vibrato Periods:
# Rate input value or function scales time against the duration of the current vibrato period. 
# Onset and release stages, having no vibrato periods, use the average vibrato period duration. 
# Use of vibrato periods requires successful detection of useable vibrato periods; failure will abort 
# synthesis.



Vibrato_Period_Durations__Mechanical_0__Natural_1=0

#
# When rate multiplier units are set to vibrato periods, time is scaled against either the
# current period length, the average period length, or a normalized proportion of each. 
# Scaling time against the current period results in nearly identical length periods--i.e. mechanically 
# precise periods; scaled against the average duration preserves the original variance of those 
# identified periods--i.e. naturally varying periods. Values between 0 and 1 give respective proportions
# of each. 

Vibrato_Period_Duration_Deviation_Threshold_As_Proportion=.1
#
# Identified vibrato periods are accepted or rejected based on the duration
# deviation threshold; the deviation threshold represents the acceptable proportional
# variance of the median duration, above or below. 



#........... RATE-CORRELATED ADJUSTMENTS ...........

Rate_Correlated_Force_Suppression_Switch__Off_0__On_1=0

# Switched on, playback rate multipliers less than 1 attenuate
# force level while adjusting median stasis levels, in both tone and noise,
# to compensate for the change in amplitude. A rate multiplier of
# 0 (stationary time) neutralizes all force, resulting in a static, stasis
# median sound, adjusted in level to correspond to the original force level.
# Recommended for rate multipliers of less than .25. 

Rate_Correlated_Noise_Level_Control_in_dB=-0
Rate_Correlated_Tone_Level_Control_in_dB=-0


# The principal purpose of this parameter is to allow adjustment of the noise level 
# as the rate multiplier approaches 1 and the overall sound becomes static as a result of force
# suppression. (See Suppression Switch above.)
# The amplitude of Noise/Residue banks are attenuated or gained in correlation with reduction in the 
# rate multiplier. A rate multiplier of 0 results in full noise attenuation/gain for the specified
# level; a rate multiplier of 1 or greater produces no attenuation of noise. 
# Set to 0 to bypass.


Rate_Correlated_Randomization_Switch__Off_0__On_1=1
# Switched on, playback rate multipliers less than 1 introduce 
# rate-correlated amplitude and frequency randomization of 
# noise/residue bins; rate of 0 produces full randomization and rates
# of 1 or greater introduce no randomization. Use to break up static 
# noise re-synthesis produced by slow to zero rates.


#........... TIME BOUNDARIES AND SAMPLER LOOP MODE ..............

# The low/high data time boundaries serve as either auto-stop
# boundaries that terminate synthesis at the crossing of a 
# data time boundary or as sampler loop points to which can 
# be added pre-loop and post-loop onset and release segments. 

lower_time_boundary=0
upper_time_boundary=-1


# -1 for low defaults to 0.0 and for high to analysis file duration.



#.....AUTOSTOP ........................................

Mode__sampler_loop_0__autostop_1=1

# In autostop mode, synthesis terminates with crossing of 
# a time boundary. In sampler loop mode, time boundaries 
# function as sampler loop points. 


#.....LOOP MODE .......................................

Sampler_Loop_Mode__wrap_0__fold_1__clip_2=1

# In Sampler Loop Mode, all timepoints are constrained to
# region between boundaries using the specified method.  
# 0: Wrap time into loop range. (/////)
# 1: Fold time into loop range. (/\/\/\/\)
# 2: Clip or limit time to the nearest boundary. (\____)

Onset_and_Release_Segment_Mode__Off_0__On_1__Onset_Only_2=0

# Setting onset/release mode in Sampler Mode causes looping
# to be preceded by a pre-loop/onset and a post-loop/release 
# segment. The data time origin is initialized to 0.0 and 
# progresses according to data time controls. The first entrance
# into the loop region triggers loop mode, which is maintained
# until trigger of the release segment. The release segment
# progresses from the current loop point to the analysis data
# end time, conforming to the data time rate control and specified
# synthesis duration. If vibrato periods are being used, then 
# data time jumps upon to the end of the vibrato period section
# at the next vibrato period boundary. In onset_only mode, the release
# segment is prevented, leaving the data in loop mode.

Normalize_Loop_Amplitudes__Off_0__On_1=0

# When set to 1, amplitudes in loop range are normalized to peak 
# amplitude of low/high boundary frames. Onset and release 
# segments are ramped in and out of loop range gain change 
# as needed.  

Loop_Smooth_Time_in_Seconds=0.2

# Loop junctures for wrapped and folded loops are smoothed
# with a lowpass filter, the smooth time of which is ramped 
# up and down before and after the loop juncture points to 
# smooth any sudden change in amplitude and frequency values.
# Too long a smooth time can introduce a bump something 
# like the one being smoothed. 
# Try .1 to .4. 


#======================================================
# ************* SYNTHETIC VIBRATO *********************
#======================================================
# For straight tones, a synthetic vibrato is available. 
# The vibrato is achieved through modulation of the 
# force level introduced into noise and tone components. 
# An on/off switch is included for each tone component. 

synthetic_Vibrato_Rate=6

synthetic_Vibrato_Randomization_Prop=0

# 0: no randomization
# 1: full randomization



#======================================================
#********** NOISE OR RESIDUAL SIGNAL ******************
#======================================================
# Remaining data lines, not selected by tones, are collected 
# together into a bank and identified with analysis noise or 
# residue. A separate copy of the noise bank is made for each 
# tone data line for use in the re-synthesis of that tone line.

noise_band_limit_level_in_dB=-0
#  Try -40 to -60

# From frame-to-frame, noise bank channel amplitudes 
# are limited to the limit level specified above; limit levels 
# are set relative to the peak average amplitudes of the adjoining 
# tone band regions.

noise_band_limit_level_rolloff_in_dB=-0
# 0 = off, try -10 to -40


# The amplitude of noise band channels may be progressively rolled
# off or on, beginning at their tone partial border edges and moving to 
# their center; rolloff is linear beginning at the limit level, 
# with each channel step toward the center accumulating more of 
# the specified rolloff.  
#
# Negative rolloff values can be used to create a trough-like suppression of
# mid-partial noise channels. Suppressing the mid noise band channels while preserving
# channels adjacent to the partial can add roughness to the partial
# band; they may also be used in place of the partial, once it is 
# appropriately attenuated and the noise band amplified.
#
# The trough-like attenuation of noise bands can be experimentally 
# inverted to make a peak-shaped noise band by first expanding 
# the noise band width and then using a low limit level with a 
# positive rolloff. For this application, try a tone bandwidth of 
# .01, a limit level of -90 or less, a positive rolloff (i.e. roll-on) 
# values of 0 to 20.

noise_band_frequency_change_suppression_threshold=0

# Try .3 to .6
# The amplitude of pitched components occurring in the noise bands
# may be reduced to some extent by suppression channel amplitude 
# in conjunction with the channel's frequency stasis. The 
# threshold, below which channels are suppressed, is a (0-1) proportion
# of one channel bandwidth traversed over 1/10th of a second--the 
# channel bandwidths is equal to the FFT analysis fundamental.
# With 0 representing no frequency change, the transition from
# static to more noise-like frequency movement corresponds to 
# about .1 to .3.
#
# This control is a relatively experimental feature, although it
# might be used to remove pitched residue components or to accentuate
# noise band roughness through selection of more transient frequency
# components. 

frequency_stasis_suppression_decibels=0

# Try -50 to -100
# Suppression decibels determine degree of channel suppression,
# applied according to the proportion of frequency change over the 
# suppression threshold. 0 is off. 

frequency_stasis_suppression_threshold_rise_response_time_in_seconds=0.0

# Try .1 to 1.0
# Increasing response times slow the rate of each channel's measured 
# increase in frequency change, thus allowing control of roughness
# by lengthening the effect of frequency stasis.

#======================================================
#**************** TONES *******************************
#======================================================

#.................. DECIBELS ..........................

gain_in_dB=0


#.................. PITCH .............................

frequency_shift=0
pitch_transposition_in_semitones=0


#======================================================
# . . . TONE SOURCE POINT ADJUSTMENT . . . . . . . . . .
#======================================================

Tone_Source_Point_Analysis_Adjustment_Switch__Off_0__On_1=0

# Switched on, the control above causes the specified 
# Tone Source Points to be refined, through analysis, to 
# a frequency lying between four semitones above and below
# the specified tone pitch or frequency.

#======================================================
# . . . PARTIAL FORMANT AUTOMATED ADJUSTMENT . 
#======================================================

partial_formant_auto_adjust__Off_0__On_1=0
#
# The partial formant auto adjust feature causes the user-specified
# bandwidth (parameter field 6) to be independently modified at 
# each partial formant in accord with the decibel stopband
# levels detected in the average spectrum relative to each 
# partial's peak amplitude. 

partial_formant_auto_adjust_stopband_level_in_dB=-30
#
# Try -20 to -40

partial_formant_auto_adjust_inclusion_threshold_in_dB=-96


#
# In auto adjust mode, partial formants whose peak dB falls 
# below the threshold are omitted and, therefore, added to the 
# noise/residue component. Setting high thresholds (-10 to -40)
# can make an interesting residue component as higher
# low gain partials are combined in with noise bins.  


#======================================================
# . . . . ANALYSIS DATA FILE . . . . .  . . . . . . . . 
#======================================================

input_analysis_file=~/pvanalysis

#======================================================
# . . . . TONES DATA FILE . . . . . . . . . . . . . . . 
#======================================================

data_file=/tmp/data

#======================================================
#***** PARAMETER FIELDS OF DATA FILE "TONES" **********
# ( Every 22 values in the data file represents a tone. )
# ( The values fill parameter fields as seen below. )
#
# 1:  Tone Source Point, in frequency or octave.pitchclass. 
#	Values < 13 are treated as octave.pitchclass. 
# 2: Tone Transpose Point, in frequency or octave.pitchclass. (func)
#	(Values < 13 are treated as octave.pitchclass.)  
# 3: Lowest Partial Number 
# 4: Partial spacing as proportion of source point frequency
#		negative = rejectmode 
# 5: Number of Partials (from lowest specified)  
#	    (0 = all partials below Nyquist frequency)
# 6: Partial Passband Bandwidth  
#	 as proportion of source point frequency 
# 7: Partial Shift Factor (func)
#	shift_in_Hz = shift_factor * source point frequency
# 8: Spectral Stretch/Compress Factor (Partial Add/Subtract) (func)
#	fund = source point frequency
#   partial_freq = partial_freq + ((partial_number - 1) * fund * factor)
#	positive values = spectral stretch
#	negative values = spectral compress
#	0 = no change
#	Note: Stretch/compress is applied using the previously shifted
#	partial frequency and number. 
# 9: Tone Decibel Level (func)
# 10: Tone Amplitude Median Stasis Position in dB (-80dB to 0dB) (func)
#	-80: minimum
#	0: maximum 
# 11: Noise Decibel Level (func)
# 12: Noise Stasis Median in dB (-80dB to 0dB) (func)
#	-80: minimum
#	0: maximum 
# 13: Noise Switch
#	0 = noise off, 1 = noise on 
# 14: Noise Transpose Point, in frequency or octave.pitchclass. (func)
#	(Values < 13 are treated as octave.pitchclass.)  
#    (0 causes noise transposition to follow tone transposition.)
# 15: Force Control (0-1 or 2 or...) (func)
#	for both Tone and Noise
#	0: tuned to partials and fixed to median amplitudes. 
#	1: original amp/freq deviation (full vibrato).  
#	0 < values < 1: values in-between.
#	Values greater than 1 increase frequency deviation; 
#		try up to 10. or more.
#	f = f * (  (f/cf)**(force - 1) 
#	where f = current frequency and cf = center frequency.
# 16: Master Tone Transposition Switch 
#	for both Tone and Noise
#	1 = use master transpose function,  
#	0 = bypass transpose  
# 17: Synthetic Vibrato Switch
#	for both Tone and Noise
#	1 = synthesize vibrato within force range
#	0 = bypass synthetic vibrato
# 18: Filter Center or Rolloff Point Frequency (func)
#	for both Tone and Noise
# 19: Filter Rolloff in dB/Octave (func)
#	for both Tone and Noise
# 20: Filter Buss Router Switch for Tone/Noise
#	0 = filter off
#	filter both tone and noise with:
#	11 = band pass, 12 = high pass, 13 = lowpass
#	filter only tone with:
#	21 = band pass, 22 = high pass, 23 = lowpass
#	filter only noise with:
#	31 = band pass, 32 = high pass, 33 = lowpass
# 21: Control Functions Delay Time Scalerswitch
#	for both Tone and Noise
# 22: Delay Time (func)
# 23: Output Channel Number: 1 to ?, 0: Use on all output channels.

#*****************************************************************

# An "m" (for mute) at the beginning of a data set will comment it out. 
# A "!" (for solo)  at the beginning of a data set will mute all other data sets.
# More than one data set may be set to solo at a time. 

# Text/data between curly braces -- "{ }" -- is cut before input, thus allowing comments.  

#======================================================

#======================================================
#========= SCRATCH SPACE ==============================
#======================================================

# 1:  TONE SOURCE POINT, in frequency or octave.pitchclass. 
#  2: TONE TRANSPOSE POINT, in frequency or octave.pitchclass. 
#  3: LOWEST PARTIAL NUMBER 
#  4: PARTIAL SPACING as proportion of fundamental
#  5: NUMBER OF PARTIALS (from lowest specified)  
#  6: PARTIAL PASSBAND BANDWIDTH  
#  7: PARTIAL SHIFT FACTOR
#  8: SPECTRAL STRETCH/COMPRESS FACTOR (Partial Add/Subtract) 
#  9: TONE DECIBEL LEVEL 
#  10: TONE STASIS MEDIAN (-80dB to 0dB)
#  11: NOISE DECIBEL LEVEL 
#  12: NOISE STASIS MEDIAN in dB (-80dB to 0dB) 
#  13: NOISE SWITCH
#  14: NOISE TRANSPOSE POINT, in frequency or octave.pitchclass. 
#  15: FORCE CONTROL (0-1 or 2 or...) 
#  16: MASTER TONE TRANSPOSITION SWITCH 
#  17: SYNTHETIC VIBRATO SWITCH
#  18: BANDPASS CENTER FREQUENCY 
#  19: BANDPASS ROLLOFF in dB/Octave 
#  20: FILTER BUSS ROUTER SWITCH for Tone/Noise
#  21: CONTROL FUNCTIONS DELAY TIME SCALER SWITCH
#  22: DELAY TIME
#  23: OUTPUT CHANNEL NUMBER

echo \
{1} 9.02 {2} 9.02 {3} 1 {4} 1 {5} 0 \
{6} 0.5 {7} 0 {8} 0 {9} 0 \
{10} -80 {11} 0 {12} -80 {13} 1 {14} 0 {15} 1 {16} 1 {17} 0 {18} 10000 {19} 0 {20} 0 {21} 1. \
{22} 0.0 {23} 0 \
\
> /tmp/data \






#********** AMPLITUDE STATISTICS ********************** 

print_amplitude_statistics_0_no__1_yes=1
amplitude_statistics_time_interval=1.0

#====================================================
# COMMAND LINE SETUP -- OFFICE USE ONLY
#      (DO NOT WRITE BELOW THIS LINE)
#====================================================
pvroutine=chordmapperplus 

PVFLAGS="\
\
-M$windowsize \
-w$window_type \
-I$frames_per_second \
\
-C$input_channel \
-t$oscillator_resynthesis_threshold_in_dB \
\
-A$MASTER_gain_in_decibels \
-D$output_duration \
\
-s$SOURCE__Off_0__On_1 \
-G$SOURCE_gain_in_dB \
-a$SOURCE_frequency_shift \
-P$SOURCE_pitch_transposition_in_semitones \
\
-L$noise_band_limit_level_in_dB \
-b$noise_band_limit_level_rolloff_in_dB \
\
-q$frequency_shift \
-X$pitch_transposition_in_semitones \
-m$gain_in_dB \
-F$data_file \
\
\
-B$Rate_Correlated_Force_Suppression_Switch__Off_0__On_1 \
-E$Rate_Correlated_Noise_Level_Control_in_dB \
-T$Rate_Correlated_Tone_Level_Control_in_dB \
\
-H$Rate_Correlated_Randomization_Switch__Off_0__On_1 \
\
-z$Mode__sampler_loop_0__autostop_1 \
\
-f$input_analysis_file \
\
-O$Tone_Source_Point_Analysis_Adjustment_Switch__Off_0__On_1 \
\
-n$partial_formant_auto_adjust__Off_0__On_1 \
-o$partial_formant_auto_adjust_stopband_level_in_dB \
-l$partial_formant_auto_adjust_inclusion_threshold_in_dB \
\
-r$synthetic_Vibrato_Rate \
-v$synthetic_Vibrato_Randomization_Prop \
\
-x$time_point_origin \
-Y$rate_multiplier \
-U$Vibrato_Period_Durations__Mechanical_0__Natural_1 \
-V$Vibrato_Period_Duration_Deviation_Threshold_As_Proportion \
\
-c$noise_band_frequency_change_suppression_threshold \
-S$frequency_stasis_suppression_decibels \
-h$frequency_stasis_suppression_threshold_rise_response_time_in_seconds \
\
-g$lower_time_boundary \
-k$upper_time_boundary \
\
-R$Use_Specified_Time_Boundaries_0__Detected_Vibrato_Periods_1 \
-u$Fundamental_Frequency_for_Vibrato_Periods_Detection \
\
-Q$Sampler_Loop_Mode__wrap_0__fold_1__clip_2 \
-@$Onset_and_Release_Segment_Mode__Off_0__On_1__Onset_Only_2 \
\
-e$Normalize_Loop_Amplitudes__Off_0__On_1 \
-/$Loop_Smooth_Time_in_Seconds \
\
\
\
-_$auto_output_sound_file_play__repetitions \
-=$rescale_level_in_decibels \
\
-p$print_amplitude_statistics_0_no__1_yes \
-i$amplitude_statistics_time_interval \
\
"
echo "$pvroutine $PVFLAGS  $output_file"

$pvroutine $PVFLAGS  $output_file 

