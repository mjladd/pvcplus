#!/bin/sh
#******************************************************
# ...... SPECTRAL FLATNESS TRAJECTORY EXTRACTOR .......
#******************************************************

#******************** OUTPUT **************************

envelope_file=/tmp/f

plot_output__1_yes__0_no=0

#******************** INPUT ***************************

analysis_sndfile=~/mySound.au


#........ BEGIN/END TIMES .............................

begintime=0.
endtime=0.

#======================================================
#*** ANALYSIS PARAMETERS ******************************

FFT_length=256
window_type=2
windowsize=0
# (0 sets windowsize to 2 * FFT (or larger))

#........... ANALYSIS CHANNEL(S) .......................
analysis_channel=1

# (channels are numbered from 1-maximum)
# (0 = all channels)

#......................................................

method_on_multiple_channels__average_0__peak_1=0

#.............   FRAMES ...............................

analysis_frames_per_second=200

#======================================================
#*************** DETECTION PARAMETERS *****************
boundary_data_type=0
#( 0 = frequency )
#( 1 = octave.pitchclass )

#............... BOUNDARIES ............................

LOW_freq_or_pitch_boundary=10000
HIGH_freq_or_pitch_boundary=22050

#............... TRAJECTORY LOW LIMIT ..................

trajectory_low_limit_in_dB=-96

#............... METHOD .................................

method__amplitude_0__amplitude_change_1__frequency_change_2=0


#............ SPECTRUM WARPSHAPE ......................

spectrum_warpshape_index=0


#................ OUTPUT RATE  ........................

ouput_sample_rate=1000

#................ OUTPUT FORMAT  ......................

output_data_format=1
#( 0: proportion )
#( 1: proportion in decibels )


#............... OUTPUT TYPE  .........................


output_data_type=1
#( 0: ascii )
#( 1: 32-bit floats )


#======================================================
#********** TRAJECTORY MODIFICATIONS ******************

#.......... TRAJECTORY RESPONSE ........................

descent_time_in_seconds=0.0
ascent_time_in_seconds=0.0


#............ WARP ....................................

trajectory_warp=0

#======================================================
#========= SCRATCH SPACE ==============================
#======================================================


#====================================================
# COMMAND LINE SETUP -- OFFICE USE ONLY
#      (DO NOT WRITE BELOW THIS LINE)
#====================================================
# ANALYSIS

#
analysisroutine=specflattracker

PVFLAGS="\
\
-N$FFT_length \
-M$windowsize \
-w$window_type \
-D$analysis_frames_per_second \
\
-b$begintime \
-e$endtime \
\
-C$analysis_channel \
\
-Q$boundary_data_type \
-f$LOW_freq_or_pitch_boundary \
-F$HIGH_freq_or_pitch_boundary \
-L$descent_time_in_seconds \
-l$ascent_time_in_seconds \
-W$trajectory_warp \
-r$ouput_sample_rate \
-g$output_data_type \
-q$output_data_format \
-c$trajectory_low_limit_in_dB \
-m$method__amplitude_0__amplitude_change_1__frequency_change_2 \
\
-H$spectrum_warpshape_index \
\
-X$method_on_multiple_channels__average_0__peak_1 \
-p1 \
-P$plot_output__1_yes__0_no \
\
"
echo "$analysisroutine $PVFLAGS $analysis_sndfile $envelope_file"

$analysisroutine $PVFLAGS $analysis_sndfile $envelope_file ;

