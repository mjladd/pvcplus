{
  "name": "PVCplus Devcontainer",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "options": ["--platform=linux/arm64"]
  },
  "runArgs": ["--platform=linux/arm64"],

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  },
  "remoteEnv": {
    "SHELL": "/usr/bin/zsh"
  },
  "postCreateCommand": "bash .devcontainer/setup-zsh.sh"
}
