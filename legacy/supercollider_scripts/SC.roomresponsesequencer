		\cf5 // ********** SAMPLED REFLECTION ORDER (RO) IMPULSE RESPONSE MODE *******************\cf2 \
		\cf5 //\cf2 \
		\cf5 // The reflection order impulse response may be used in a special sampled mode\cf2 \
		\cf5 // in which windowed samples of the response are taken from points in the response's time\cf2 \
		\cf5 // corresponding to the reflection delay times. Used without sync, samples are taken\cf2 \
		\cf5 // from an impulse response point computed as the average delay time for that order;\cf2 \
		\cf5 // adding synchronization (i.e. with sync) causes windowed samples to be sampled at \cf2 \
		\cf5 // the reflection's exact delay time, which causes a synchronization of all reflection \cf2 \
		\cf5 // sample points that effectively replicates the original impulse response through its \cf2 \
		\cf5 // synchronized summed reconstruction. Without sync, each reflection order's \cf2 \
		\cf5 // sampled response window is shifted in time by according to its respective reflection time, \cf2 \
		\cf5 // which has the net effect of preserving each reflection's unique presence in time while\cf2 \
		\cf5 // imparting the general characteristic of the original impulse response associated with\cf2 \
		\cf5 // that delay point.  \cf2 \
		\cf5 //\cf2 \
		\cf5 // Scaling the convolved windowed samples further preserves the original\cf2 \
		\cf5 // impulse response identity by conforming to the response's original amplitude levels. \cf2 \
\
		\cf5 // QW\cf2 \
		reflection_order_ir_window_sample_mode__off_0__on_1__on_with_sync_2 = 0 ;\
\
		scale_to_pre_envelope_window_sample_peak_amps__off_0__on_1 = 0 ;\
\
		\cf5 //\cf2 \
		\cf5 // The duration of the sampled response windows are equal to the sum of their\cf2 \
		\cf5 // attack and release times, which are the only envelope stages used. The\cf2 \
		\cf5 // parameters below determine the duration of those stages, specifying them\cf2 \
		\cf5 // as a function of low to high reflection order. In addition, the shape of the\cf2 \
		\cf5 // window's envelope may be warped using the envelope shape index; as with other \cf2 \
		\cf5 // applications of this index, positive values sharpen the window's peak and decrease\cf2 \
		\cf5 // its underlying area, negative values do the opposite.  \cf2 \
		\cf5 //\cf2 \
