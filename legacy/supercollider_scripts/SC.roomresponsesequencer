\
		\cf5 // ------------------------------------------------------------------------\cf2 \
		\cf5 // ******************* WALL IMPULSE RESPONSES *****************************\cf2 \
		\cf5 // ------------------------------------------------------------------------\cf2 \
		\cf5 //\cf2 \
		\cf5 // Impulse responses may be used not only in conjunction with reflection orders, but \cf2 \
