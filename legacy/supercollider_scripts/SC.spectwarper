{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf2 (\
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  spectwarper = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		oscillator_resynthesis_threshold_in_db, \
		compander_response_time_in_seconds, \
		begintime, \
		window_type, \
		low_shelf_eq_gain_in_decibels, \
		pitch_transposition_in_semitones, \
		high_cutoff_frequency, \
		print_amplitude_statistics_0_no__1_yes, \
		compander_window_size_in_octaves_or_hz, \
		low_cutoff_frequency, \
		output_file, \
		high_shelf_eq_gain_in_decibels, \
		output_channel, \
		peak_following_release_response_time_in_seconds, \
		time_expansion_contraction_factor, \
		amplitude_statistics_time_interval, \
		frequency_shift, \
		decibels_of_compression, \
		warp_curve_index, \
		decibels_of_expansion, \
		high_shelf_eq_frequency, \
		windowsize, \
		gain_in_decibels, \
		expansion_threshold_in_db, \
		frames_per_second, \
		octaves_of_rolloff, \
		compression_threshold_in_db, \
		frame_normalization_decibel_limit, \
		low_shelf_eq_frequency, \
		peak_following_attack_response_time_in_seconds, \
		input_file, \
		endtime, \
		complement_spectrum_proportion, \
		rescale_level_in_decibels, \
		auto_output_sound_file_play__repetitions, \
		fft_length\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //..................... SPECTWARPER ......................\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 // Spectwarper uses the same processing as compander\cf2 \
		\cf5 // with the modification that bins changed through \cf2 \
		\cf5 // compression are limited to levels beyond the compression \cf2 \
		\cf5 // threshold down to zero; this turns the compression \cf2 \
		\cf5 // threshold into a limiting boundary separating strong \cf2 \
		\cf5 // and weak bins. The separation of the sound into\cf2 \
		\cf5 // strong and weak bins offers access to a sound's \cf2 \
		\cf5 // pitch and noise, or, more generally, its \cf2 \
		\cf5 // principal and residual components. With spectwarper,\cf2 \
		\cf5 // breathy violin notes, for example, can be separated \cf2 \
		\cf5 // into pitch and noise, or colorful ride cymbals into\cf2 \
		\cf5 // their stronger and weaker pitch nodes. \cf2 \
		\cf5 //\cf2 \
		\cf5 // Compression brings out the weaker/noisier bins whereas\cf2 \
		\cf5 // expansion privileges the stronger/resonant bins. The\cf2 \
		\cf5 // 0-1 complement control offers dynamic control of the \cf2 \
		\cf5 // transition between the current strong/weak setting and \cf2 \
		\cf5 // its inverse or complement. \cf2 \
		\cf5 //\cf2 \
		\cf5 // The rescale feature allows for easy amplification of \cf2 \
		\cf5 // the reduced signal energy levels produced by compression.\cf2 \
		\cf5 // However, the rescale feature will not equalize moment-to-moment \cf2 \
		\cf5 // differences in signal level incurred through \cf2 \
		\cf5 // shifts from pitch to noise created through complement\cf2 \
		\cf5 // control transitions. Dynamic normalization, which addresses\cf2 \
		\cf5 // these differences, can be achieved, however, through the \cf2 \
		\cf5 // frame normalization feature, which offers dynamic rescaling \cf2 \
		\cf5 // of the frame to its original energy level or less. \cf2 \
		\cf5 // The frame normalization limit sets the degree of frame\cf2 \
		\cf5 // normalization; values greater than 0dB will cause \cf2 \
		\cf5 // frames to be normalized to match the frame's original \cf2 \
		\cf5 // overall energy level, up to the specified limit. \cf2 \
		\cf5 // \cf2 \
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		output_file = \cf4 "/tmp/output.au"\cf2  ;\
\
		\cf5 // The following may be used to copy a formatted\cf2 \
		\cf5 // sound file into the output location listed above.   \cf2 \
\
		\cf5 //cp ~/32bit.BLANK.au $output_file\cf2 \
\
\
		\cf5 //...............AUTO-PLAY OF OUTPUT FILE...............\cf2 \
		auto_output_sound_file_play__repetitions = 0 ;\
		\cf5 //(-2 = interactive: Play once, then prompts for more.)\cf2 \
		\cf5 //(-1 = interactive: Prompt for each play of file.)\cf2 \
		\cf5 //( 0 = off)\cf2 \
		\cf5 //( 1 or greater = Auto-repeat for specified repetitions.)\cf2 \
\
		\cf5 //................ RESCALE .............................\cf2 \
\
		rescale_level_in_decibels = 0 ;\
		\cf5 //(-96 to 0 dB. )\cf2 \
		\cf5 //(Set to 1 to rescale to peak of input file.)\cf2 \
		\cf5 //(Set to 2 to bypass rescale.)\cf2 \
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
		input_file = \cf4 "~/violin.A5.au"\cf2  ;\
\
		\cf5 //........ BEGIN/END TIMES .............................\cf2 \
		begintime = 0 ;\
		endtime = 0 ;\
		\cf5 // (0 end time defaults to end of file)\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
\
		fft_length = 4096 ;\
		window_type = 8 ;\
		windowsize = 0 ;\
\
		\cf5 // Try window_type 12 for good separation of noise and\cf2 \
		\cf5 //   pitch. \cf2 \
\
		frames_per_second = 200 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** RESYNTHESIS PARAMETERS ***************************\cf2 \
\
\
		\cf5 //........... OUTPUT CHANNEL(S) .......................\cf2 \
\
		output_channel = 0 ;\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		\cf5 //.............OSCIL THRESHOLD ........................\cf2 \
\
		oscillator_resynthesis_threshold_in_db = -96 ;\
\
		\cf5 //****************** MODIFICATIONS *********************\cf2 \
\
		\cf5 //.................. TIME ..............................\cf2 \
\
		time_expansion_contraction_factor = 1 ;\
\
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		gain_in_decibels = 0 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		frequency_shift = 0 ;\
		pitch_transposition_in_semitones = 0 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //****** COMPRESSION/EXPANSION PARAMETERS **************\cf2 \
\
\
		\cf5 //.....COMPANDER FREQUENCY BAND ......................\cf2 \
\
		low_cutoff_frequency = 0 ;\
		high_cutoff_frequency = 20000 ;\
		octaves_of_rolloff = 0 ;\
\
\
		\cf5 //  Choose to compress, for noise/residue, or expand, for pitch/resonance,\cf2 \
		\cf5 //  by setting the respective threshold and decibel levels below.  \cf2 \
		\cf5 //  Less interesting, though possible, is the selection of an \cf2 \
		\cf5 //  amplitude band. To do this, set the expand threshold below \cf2 \
		\cf5 //  the compress threshold, and give both substantial reduction levels.\cf2 \
\
		\cf5 //.....COMPRESSION..(NOISE)...........................\cf2 \
\
		compression_threshold_in_db = -10 ;\
		\cf5 //( Try -10 to -30 with -96 below to compress out pitch/resonance.)\cf2 \
		decibels_of_compression = -0 ;\
\
		\cf5 //.....EXPANSION..(PITCH)...............................\cf2 \
\
		expansion_threshold_in_db = -3 ;\
		\cf5 //( Try -2 with -96 below to expand out residue and noise.)\cf2 \
		decibels_of_expansion = -0 ;\
\
		\cf5 //......... COMPLEMENT SPECTRUM PROPORTION ..............\cf2 \
\
		complement_spectrum_proportion = 0 ;\
\
		\cf5 //  A value of 1 produces the inversion of the current \cf2 \
		\cf5 //  compression/expansion settings given above. A value of \cf2 \
		\cf5 //  0 produces no change to the settings. Values in-between \cf2 \
		\cf5 //  0 and 1 interpolate between no change and the\cf2 \
		\cf5 //  inverted noise/pitch spectrum. \cf2 \
		\cf5 //\cf2 \
		\cf5 //  For example, if the settings above produced an (expanded) spectrum \cf2 \
		\cf5 //  highlighting the resonant parts of the sound, then a value \cf2 \
		\cf5 //  of 1  would produce its (compressed) complement of residual-noise \cf2 \
		\cf5 //  components. A function moving from 0-1 would create a crossfade \cf2 \
		\cf5 //  between the original setting and its inversion or complement.\cf2 \
\
		\cf5 //......................................................\cf2 \
\
		compander_window_size_in_octaves_or_hz = 0.0 ;\
\
		\cf5 // Variable Units\cf2 \
		\cf5 // 0 = off\cf2 \
		\cf5 // Values between 0 and 8 are treated as octaves, offering pitch windows.\cf2 \
		\cf5 // Values greater than 8 are treated as Herz, offering frequency windows.\cf2 \
\
		\cf5 // Compression/expansion is created by warping the amplitude of each\cf2 \
		\cf5 // bin against the peak amplitude of the collection of adjacent bins lying\cf2 \
		\cf5 // within the specified pitch/frequency window centered on the bin frequency. \cf2 \
		\cf5 // The width of the window is determined by the compander window size, specified\cf2 \
		\cf5 // in units of octaves or Herz.\cf2 \
		\cf5 //\cf2 \
		\cf5 // The larger the window, the more suppression will occur\cf2 \
		\cf5 // in favor of the few strongest formants. Consider windows in the \cf2 \
		\cf5 // region of (or greater than) the fundamental frequency of the sound's\cf2 \
		\cf5 // pitched material. Very large windows are equivalent to 0, or off, \cf2 \
		\cf5 // which uses one window for the whole spectrum.\cf2 \
\
		\cf5 //....PEAK FOLLOWING RESPONSE TIMES ....................\cf2 \
\
		peak_following_attack_response_time_in_seconds = 0.0 ;\
		peak_following_release_response_time_in_seconds = 0.0 ;\
\
		\cf5 //  In normal mode, amplitudes are warped against the\cf2 \
		\cf5 //  peak amp of the current analysis frame, a peak that, in\cf2 \
		\cf5 // sucession represents the amplitude envelope of the signal. \cf2 \
		\cf5 //  Setting non-zero response times for the parameters above \cf2 \
		\cf5 //  delays the attack and decay features of this envelope, which, \cf2 \
		\cf5 //  in turn, changes the warp of amplitudes by changing the current peak. \cf2 \
		\cf5 //  The best use is with non-zero release times. \cf2 \
		\cf5 //  These perpetuate strong envelope peaks that  expand\cf2 \
		\cf5 //  out the decays after them.\cf2 \
\
		\cf5 //......................................................\cf2 \
\
		warp_curve_index = 3 ;\
\
		\cf5 // An index of 0 produces a linear gradient. Positive warp curve  \cf2 \
		\cf5 //  values smooth the transition into the compression/expansion \cf2 \
		\cf5 //  regions, negative values sharpen the transition.\cf2 \
\
		\cf5 //......................................................\cf2 \
\
		compander_response_time_in_seconds = 0.0 ;\
		\cf5 // Try .05\cf2 \
		\cf5 //  Use values from .01-.2 or more to remove the gurgle and \cf2 \
		\cf5 //  roughness caused by  the oscillation of components\cf2 \
		\cf5 //  into and out of the compander band.\cf2 \
\
		\cf5 //********* FRAME NORMALIZATION ******************************\cf2 \
\
		frame_normalization_decibel_limit = 0 ;\
		\cf5 // Scale the amplitudes of each output frame against the input frame\cf2 \
		\cf5 // using a scaling ratio formed from the sum of the input frame amplitudes\cf2 \
		\cf5 // over the sum of the output frame amplitudes limited by the decibel limit. \cf2 \
		\cf5 // Use up to 100 or less as needed; 0 prevents normalization. \cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //*************** LOW/HIGH SHELF EQ *********************\cf2 \
		low_shelf_eq_gain_in_decibels = -0 ;\
		low_shelf_eq_frequency = 1000 ;\
\
		high_shelf_eq_gain_in_decibels = -0 ;\
		high_shelf_eq_frequency = 8000 ;\
\
		\cf5 //********** AMPLITUDE STATISTICS ******************** \cf2 \
		print_amplitude_statistics_0_no__1_yes = 1 ;\
		amplitude_statistics_time_interval = 1 ;\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //========= SCRATCH SPACE ==============================\cf2 \
		\cf5 //======================================================\cf2 \
\
\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "spectwarper "\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -M"\cf2  ++ windowsize ++  \cf4 " -H"\cf2  ++ low_shelf_eq_gain_in_decibels ++  \cf4 " -L"\cf2  ++ peak_following_release_response_time_in_seconds ++ \
			 \cf4 " -S"\cf2  ++ compander_window_size_in_octaves_or_hz ++  \cf4 " -b"\cf2  ++ begintime ++ \
			 \cf4 " -W"\cf2  ++ warp_curve_index ++  \cf4 " -="\cf2  ++ rescale_level_in_decibels ++  \cf4 " -N"\cf2  ++ fft_length ++ \
			 \cf4 " -q"\cf2  ++ expansion_threshold_in_db ++  \cf4 " -l"\cf2  ++ peak_following_attack_response_time_in_seconds ++ \
			 \cf4 " -w"\cf2  ++ window_type ++  \cf4 " -r"\cf2  ++ compander_response_time_in_seconds ++  \cf4 " -a"\cf2  ++ frequency_shift ++ \
			 \cf4 " -n"\cf2  ++ frame_normalization_decibel_limit ++  \cf4 " -i"\cf2  ++ amplitude_statistics_time_interval ++ \
			 \cf4 " -o"\cf2  ++ compression_threshold_in_db ++  \cf4 " -P"\cf2  ++ pitch_transposition_in_semitones ++ \
			 \cf4 " -f"\cf2  ++ octaves_of_rolloff ++  \cf4 " -R"\cf2  ++ high_shelf_eq_frequency ++  \cf4 " -g"\cf2  ++ complement_spectrum_proportion ++ \
			 \cf4 " -A"\cf2  ++ gain_in_decibels ++  \cf4 " -D"\cf2  ++ frames_per_second ++  \cf4 " -m"\cf2  ++ low_shelf_eq_frequency ++ \
			 \cf4 " -O"\cf2  ++ decibels_of_compression ++  \cf4 " -d"\cf2  ++ high_cutoff_frequency ++  \cf4 " -C"\cf2  ++ output_channel ++ \
			 \cf4 " -X"\cf2  ++ high_shelf_eq_gain_in_decibels ++  \cf4 " -Q"\cf2  ++ decibels_of_expansion ++ \
			 \cf4 " -I"\cf2  ++ time_expansion_contraction_factor ++  \cf4 " -p"\cf2  ++ print_amplitude_statistics_0_no__1_yes ++ \
			 \cf4 " -t"\cf2  ++ oscillator_resynthesis_threshold_in_db ++  \cf4 " -c"\cf2  ++ low_cutoff_frequency ++ \
			 \cf4 " -_"\cf2  ++ auto_output_sound_file_play__repetitions ++  \cf4 " -e"\cf2  ++ endtime\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ input_file ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
spectwarper.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
)\
}