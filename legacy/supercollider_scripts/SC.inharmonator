{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf2 (\
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  inharmonator = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		non_targets_time_delay_response_time_in_seconds, \
		non_targets_decay_time, \
		non_targets_time_delay_randomization__off_0__on_1, \
		source_frequency_shift, \
		targets_frequency_shift, \
		targets_time_delay_randomization__off_0__on_1, \
		frequency_response_time_in_seconds, \
		auto_output_sound_file_play__repetitions, \
		input_file, \
		targets__decay_time_scaler, \
		endtime, \
		targets__delay_time_scaler, \
		targets_time_interpolation_control, \
		targets_frequency_interpolation_control, \
		non_targets_delay_time, \
		windowsize, \
		targets_partialwindowtype__rectangle_0__hann_1__welch_2, \
		non_targets_frequency_shift, \
		shift_data_format, \
		targets_amplitude_interpolation_control, \
		output_channel, \
		attack_time_in_seconds, \
		begintime, \
		source_gain_in_db, \
		targets_gain_in_db, \
		source_release_time_in_seconds, \
		targets__decay_time_shifter, \
		source_delay_time, \
		targets__partial_number_scaler, \
		fft_length, \
		frames_per_second, \
		targets_partial_bandwidth_proportion, \
		spectrum_warpshape_index, \
		targets_decibels_scaler, \
		release_time_in_seconds, \
		oscillator_resynthesis_threshold_in_db, \
		print_amplitude_statistics_0_no__1_yes, \
		time_expansion_contraction_factor, \
		targets_pitch_transposition_in_semitones, \
		targets__partial_number_shifter, \
		source_attack_time_in_seconds, \
		targets_fundamental_frequency_or_octavepointpitchclass, \
		output_file, \
		targets_shift_file, \
		targets__delay_time_shifter, \
		non_targets_gain_in_db, \
		targets_time_delay_response_time_in_seconds, \
		window_type, \
		non_targets_pitch_transposition_in_semitones, \
		rescale_level_in_decibels, \
		amplitude_statistics_time_interval, \
		master_gain_in_decibels, \
		source_pitch_transposition_in_semitones\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //................. INHARMONATOR .......................\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 // Inharmonator uses the specified fundamental frequency, \cf2 \
		\cf5 // bandwidth, and data file of harmonics, map points, and \cf2 \
		\cf5 // amplitudes to transpose particular bins in the analysis; \cf2 \
		\cf5 // the identified and shifted bins are known as the "targets" \cf2 \
		\cf5 // and have macro controls for their manipulation as a group. \cf2 \
		\cf5 // The remaining analysis bins (identified as the "non-targets) \cf2 \
		\cf5 // and the source may be included in the output, through \cf2 \
		\cf5 // separate adjustment of their pitch, amplitude, and time. \cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //********** AMPLITUDE STATISTICS *********************** \cf2 \
		print_amplitude_statistics_0_no__1_yes = 1 ;\
		amplitude_statistics_time_interval = 1.0 ;\
\
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		output_file = \cf4 "/tmp/output.au"\cf2  ;\
\
		\cf5 // The following may be used to copy a formatted\cf2 \
		\cf5 // sound file into the output location listed above.   \cf2 \
\
		\cf5 //cp ~/32bit.BLANK.au $output_file\cf2 \
\
\
		\cf5 //...............AUTO-PLAY OF OUTPUT FILE...............\cf2 \
		auto_output_sound_file_play__repetitions = 0 ;\
		\cf5 //(-2 = interactive: Play once, then prompts for more.)\cf2 \
		\cf5 //(-1 = interactive: Prompt for each play of file.)\cf2 \
		\cf5 //( 0 = off)\cf2 \
		\cf5 //( 1 or greater = Auto-repeat for specified repetitions.)\cf2 \
\
		\cf5 //................ RESCALE .............................\cf2 \
\
		rescale_level_in_decibels = -0 ;\
		\cf5 //(-96 to 0 dB. )\cf2 \
		\cf5 //(Set to 1 to rescale to peak of input file.)\cf2 \
		\cf5 //(Set to 2 to bypass rescale.)\cf2 \
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
		input_file = \cf4 "~/oboe.B4.au"\cf2  ;\
\
		\cf5 //........ BEGIN/END TIMES .............................\cf2 \
\
		begintime = 0 ;\
		endtime = 0 ;\
		\cf5 // End time or 0 or less defaults to end of file.\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
\
		fft_length = 4096 ;\
		\cf5 // Powers of two (512, 1024, 2048, 4096...)\cf2 \
		\cf5 // Larger values increase bins, adding frequency resolution while\cf2 \
		\cf5 // decreasing time resolution; smaller values effect the opposite.   \cf2 \
		\cf5 // Start with 1024. \cf2 \
\
		window_type = 12 ;\
\
		\cf5 // hamming(0),  rectangular(1) Blackman(2), Bartlett(3)\cf2 \
		\cf5 // Kaiser(4-12) for corresponding alpha values:\cf2 \
		\cf5 // alpha = 4: sidelobe of -30dB, narrow center lobe\cf2 \
		\cf5 // alpha = 8: sidelobe of -58dB, medium center lobe\cf2 \
		\cf5 // alpha = 4: sidelobe of -90dB, wide center lobe\cf2 \
\
		windowsize = 0 ;\
		\cf5 // (0 sets windowsize to 2 * FFT)\cf2 \
\
		frames_per_second = 200 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** RESYNTHESIS PARAMETERS ***************************\cf2 \
\
		\cf5 //.................. TIME ..............................\cf2 \
\
		time_expansion_contraction_factor = 1 ;\
\
		\cf5 //........... OUTPUT CHANNEL(S) .......................\cf2 \
		output_channel = 1 ;\
\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		\cf5 //.............OSCIL THRESHOLD ........................\cf2 \
\
		oscillator_resynthesis_threshold_in_db = -96 ;\
\
		\cf5 //****************** MODIFICATIONS *********************\cf2 \
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		master_gain_in_decibels = 0 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //********** SOURCE ************************************\cf2 \
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		source_gain_in_db = -100 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		source_frequency_shift = 0 ;\
		source_pitch_transposition_in_semitones = 0 ;\
\
		\cf5 //gen4 -L1000 0 0 0	1 7 > /tmp/pt\cf2 \
\
		\cf5 //............ AMPLITUDE RESPONSE ......................\cf2 \
\
		source_attack_time_in_seconds = 0 ;\
		source_release_time_in_seconds = 0 ;\
\
		\cf5 //.................. DELAY TIME ........................\cf2 \
\
		source_delay_time = 0 ;\
\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //********** INHARMONATOR ********************************\cf2 \
		\cf5 //======================================================\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //************ TARGETS AND NON-TARGETS *****************\cf2 \
\
		\cf5 //............ SPECTRUM WARPSHAPE ......................\cf2 \
		spectrum_warpshape_index = 0 ;\
		\cf5 // Values greater than 0 expand dynamic range, suppressing\cf2 \
		\cf5 // weaker amplitudes.\cf2 \
\
		\cf5 //.... RESPONSE TIME  ...........\cf2 \
\
		attack_time_in_seconds = 0 ;\
		release_time_in_seconds = 0 ;\
		frequency_response_time_in_seconds = 0 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //********** NON TARGETS ********************************\cf2 \
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		non_targets_gain_in_db = -0 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		non_targets_frequency_shift = 0 ;\
		non_targets_pitch_transposition_in_semitones = 0 ;\
\
\
		\cf5 //.................. DELAY TIME ........................\cf2 \
\
		non_targets_delay_time = 0 ;\
\
\
		non_targets_decay_time = 0 ;\
\
		non_targets_time_delay_randomization__off_0__on_1 = 0 ;\
		non_targets_time_delay_response_time_in_seconds = 0.2 ;\
		\cf5 // .2 or more\cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*************** TARGETS ********************************\cf2 \
\
		\cf5 //............ FUNDAMENTAL FREQUENCY .....................\cf2 \
\
		targets_fundamental_frequency_or_octavepointpitchclass = 57.4 ;\
		\cf5 //\cf2 \
		\cf5 // Values of 12 or less are treated as octave.pitchclass.\cf2 \
		\cf5 // 8.00 = middle C\cf2 \
\
		targets_partial_bandwidth_proportion = 0.4 ;\
\
		targets_partialwindowtype__rectangle_0__hann_1__welch_2 = 1 ;\
\
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		targets_gain_in_db = -0 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		targets_frequency_shift = 0 ;\
		targets_pitch_transposition_in_semitones = 0 ;\
\
\
		\cf5 //................. TIME DELAY .........................\cf2 \
		targets_time_delay_randomization__off_0__on_1 = 0 ;\
		targets_time_delay_response_time_in_seconds = 0.5 ;\
\
		targets_shift_file = \cf4 "~/partials"\cf2  ;\
\
		shift_data_format = 3 ;\
\
		\cf5 //( 0 = frequency multiplier )\cf2 \
		\cf5 //( 1 = map to frequency )\cf2 \
		\cf5 //( 2 = map to octave.pitchclass )\cf2 \
		\cf5 //( 3 = map to partial number )\cf2 \
\
\
\
		\cf5 //*****TARGETS SHIFT FILE: DATA FORMAT ******************\cf2 \
		\cf5 // Only one shift-line per partial \cf2 \
		\cf5 // (Duplicate partial specifications revert to last in list.)\cf2 \
		\cf5 // 1: partial number\cf2 \
		\cf5 // 2: shift data (in format specified above)\cf2 \
		\cf5 // 3: decibels\cf2 \
		\cf5 // 4: delay time\cf2 \
		\cf5 // 5: decay time\cf2 \
\
		\cf5 // An "m" (for mute) at the beginning of a data set will comment it out. \cf2 \
		\cf5 // A "!" (for solo)  at the beginning of a data set will mute all other data sets.\cf2 \
		\cf5 // More than one data set may be set to solo at a time. \cf2 \
\
		\cf5 // Text/data between curly braces -- "\{ \}" -- is cut before input, thus allowing comments.  \cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //**** SCALERS AND SHIFTERS FOR DATA SETUP \cf2 \
		\cf5 //======================================================\cf2 \
		\cf5 // The following controls allow pre-synthesis, \cf2 \
		\cf5 // macro-modification of values in particular parameters. \cf2 \
		\cf5 //\cf2 \
		\cf5 // Scalers are multipliers, shifts are adders. \cf2 \
		\cf5 // Thus, multipliers of 1 and shifts of 0 produce\cf2 \
		\cf5 // no change to parameter values. Negative values \cf2 \
		\cf5 // are allowed. Scaling is always applied first, followed \cf2 \
		\cf5 // by shifting. Beware the accident of a scalar value of 0.\cf2 \
\
		\cf5 // ** PARTIAL NUMBER\cf2 \
		\cf5 // Partial numbers less than 1 become 1. \cf2 \
\
		targets__partial_number_scaler = 1 ;\
		\cf5 //\cf2 \
		\cf5 // With 1 as floor, i.e. 1 remains constant.\cf2 \
		\cf5 // [1, 2, 3, 4] become [1, 3, 5, 7] with scaler of 2.\cf2 \
		\cf5 // new_partial_number = 1 + (scaler * (partial_number - 1))\cf2 \
\
		targets__partial_number_shifter = 0 ;\
\
		\cf5 // ** DECIBELS\cf2 \
		targets_decibels_scaler = 1.0 ;\
\
		\cf5 // ** DELAY TIME\cf2 \
		targets__delay_time_scaler = 1.0 ;\
		targets__delay_time_shifter = 0 ;\
\
		\cf5 // ** DECAY TIME\cf2 \
		targets__decay_time_scaler = 1.0 ;\
		targets__decay_time_shifter = 0 ;\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** AMPLITUDE AND FREQUENCY INTERPOLATION CONTROLS **\cf2 \
		\cf5 //======================================================\cf2 \
		\cf5 // 0: original source values\cf2 \
		\cf5 // 1: target values\cf2 \
		\cf5 // 0-1: interpolation between, by constant or function\cf2 \
\
\
		targets_amplitude_interpolation_control = 1 ;\
\
\
		targets_frequency_interpolation_control = 1 ;\
\
\
		targets_time_interpolation_control = 1 ;\
\
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //========= SCRATCH SPACE ==============================\cf2 \
		\cf5 //======================================================\cf2 \
\
		\cf5 //[partial number][shift data][decibels][delay time][ decay time]\cf2 \
\
\
		addCommand.value(\
			\cf4 "echo  \
			 \
			1  1.1   0 0.0 0  \
			2  1.9   -0 0.0 0  \
			3  3.5   -0 0.0 0  \
			4  4.4   -0 0.0 0  \
			5  5.7   0 0.0 0  \
			6  5.8   -0 0.0 0  \
			7  7.8   -0 0.0 0  \
			8  8.9   -0 0.0 0  \
			9  10    0 0.0 0  \
			 \
			 \
			> ~/partials ;"\cf2 \
		) ;\
\
\
\
\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "inharmonator"\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -R"\cf2  ++ targets__partial_number_shifter ++  \cf4 " -D"\cf2  ++ frames_per_second ++ \
			 \cf4 " -m"\cf2  ++ targets_gain_in_db ++  \cf4 " -H"\cf2  ++ targets_time_delay_randomization__off_0__on_1 ++ \
			 \cf4 " -b"\cf2  ++ begintime ++  \cf4 " -y"\cf2  ++ targets_decibels_scaler ++  \cf4 " -G"\cf2  ++ non_targets_gain_in_db ++ \
			 \cf4 " -W"\cf2  ++ spectrum_warpshape_index ++  \cf4 " -Z"\cf2  ++ shift_data_format ++  \cf4 " -K"\cf2  ++ non_targets_time_delay_randomization__off_0__on_1 ++ \
			 \cf4 " -Y"\cf2  ++ frequency_response_time_in_seconds ++  \cf4 " -Q"\cf2  ++ source_frequency_shift ++ \
			 \cf4 " -p"\cf2  ++ print_amplitude_statistics_0_no__1_yes ++  \cf4 " -l"\cf2  ++ source_attack_time_in_seconds ++ \
			 \cf4 " -r"\cf2  ++ source_gain_in_db ++  \cf4 " -a"\cf2  ++ non_targets_frequency_shift ++  \cf4 " -o"\cf2  ++ targets__delay_time_scaler ++ \
			 \cf4 " -P"\cf2  ++ non_targets_pitch_transposition_in_semitones ++  \cf4 " -g"\cf2  ++ targets__decay_time_scaler ++ \
			 \cf4 " -j"\cf2  ++ non_targets_delay_time ++  \cf4 " -A"\cf2  ++ master_gain_in_decibels ++  \cf4 " -M"\cf2  ++ windowsize ++ \
			 \cf4 " -S"\cf2  ++ targets_frequency_interpolation_control ++  \cf4 " -L"\cf2  ++ source_release_time_in_seconds ++ \
			 \cf4 " -="\cf2  ++ rescale_level_in_decibels ++  \cf4 " -V"\cf2  ++ release_time_in_seconds ++ \
			 \cf4 " -k"\cf2  ++ targets__decay_time_shifter ++  \cf4 " -I"\cf2  ++ time_expansion_contraction_factor ++ \
			 \cf4 " -v"\cf2  ++ attack_time_in_seconds ++  \cf4 " -t"\cf2  ++ oscillator_resynthesis_threshold_in_db ++ \
			 \cf4 " -x"\cf2  ++ targets_partial_bandwidth_proportion ++  \cf4 " -u"\cf2  ++ source_pitch_transposition_in_semitones ++ \
			 \cf4 " -f"\cf2  ++ targets_fundamental_frequency_or_octavepointpitchclass ++  \cf4 " -c"\cf2  ++ targets_time_delay_response_time_in_seconds ++ \
			 \cf4 " -i"\cf2  ++ amplitude_statistics_time_interval ++  \cf4 " -U"\cf2  ++ targets_amplitude_interpolation_control ++ \
			 \cf4 " -E"\cf2  ++ non_targets_decay_time ++  \cf4 " -O"\cf2  ++ targets__delay_time_shifter ++ \
			 \cf4 " -C"\cf2  ++ output_channel ++  \cf4 " -X"\cf2  ++ targets_pitch_transposition_in_semitones ++ \
			 \cf4 " -T"\cf2  ++ targets_time_interpolation_control ++  \cf4 " -B"\cf2  ++ targets_partialwindowtype__rectangle_0__hann_1__welch_2 ++ \
			 \cf4 " -N"\cf2  ++ fft_length ++  \cf4 " -z"\cf2  ++ targets__partial_number_scaler ++  \cf4 " -q"\cf2  ++ targets_frequency_shift ++ \
			 \cf4 " -w"\cf2  ++ window_type ++  \cf4 " -J"\cf2  ++ source_delay_time ++  \cf4 " -F"\cf2  ++ targets_shift_file ++ \
			 \cf4 " -n"\cf2  ++ non_targets_time_delay_response_time_in_seconds ++  \cf4 " -_"\cf2  ++ auto_output_sound_file_play__repetitions ++ \
			 \cf4 " -e"\cf2  ++ endtime\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ input_file ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
inharmonator.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
)\
}