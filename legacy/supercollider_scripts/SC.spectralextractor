\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  spectralextractor = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		windowsize, \
		spectrum_warpshape_index, \
		frequency_shift, \
		high_shelf_eq_frequency, \
		auto_output_sound_file_play__repetitions, \
		frames_per_second, \
		freq_change_threshold_in_hz, \
		print_amplitude_statistics_0_no__1_yes, \
		time_expansion_contraction_factor, \
		low_shelf_eq_gain_in_decibels, \
		input_file, \
		high_shelf_eq_gain_in_decibels, \
		window_type, \
		output_file, \
		complement_spectrum_proportion, \
		resynthesis_channel_1_to_max__0_all, \
		extract_periodic_0__noise_1, \
		rescale_level_in_decibels, \
		fft_length, \
		gain_in_decibels, \
		frame_normalization_decibel_limit, \
		low_shelf_eq_frequency, \
		begintime, \
		endtime, \
		amplitude_statistics_time_interval, \
		oscillator_resynthesis_threshold_in_db, \
		pitch_transposition_in_semitones, \
		amplitude_change_response_time_in_seconds, \
		threshold_accumulator_response_time\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //********** SPECTRAL EXTACTOR *************************\cf2 \
		\cf5 //******************************************************\cf2 \
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		output_file = \cf4 "/tmp/output.au"\cf2  ;\
\
		\cf5 // The following may be used to copy a formatted\cf2 \
		\cf5 // sound file into the output location listed above.   \cf2 \
\
		\cf5 //cp ~/32bit.BLANK.au $output_file\cf2 \
\
		\cf5 //...............AUTO-PLAY OF OUTPUT FILE...............\cf2 \
		auto_output_sound_file_play__repetitions = 1 ;\
		\cf5 //(-2 = interactive: Play once, then prompts for more.)\cf2 \
		\cf5 //(-1 = interactive: Prompt for each play of file.)\cf2 \
		\cf5 //( 0 = off)\cf2 \
		\cf5 //( 1 or greater = Auto-repeat for specified repetitions.)\cf2 \
\
		\cf5 //................ RESCALE .............................\cf2 \
\
		rescale_level_in_decibels = -0 ;\
		\cf5 //(-96 to 0 dB. )\cf2 \
		\cf5 //(Set to 1 to rescale to peak of input file.)\cf2 \
		\cf5 //(Set to 2 to bypass rescale.)\cf2 \
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
\
		input_file = \cf4 "~/ridecymbal.au"\cf2  ;\
\
		\cf5 //******** BEGIN/END TIMES *****************************\cf2 \
		\cf5 // (-1 end time defaults to end of file)\cf2 \
		begintime = 0 ;\
		endtime = 0 ;\
\
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
		fft_length = 1024 ;\
		\cf5 // Suggested settings below are based on a 1024 FFT.\cf2 \
		\cf5 // BEWARE: Other lengths will behave quite differently!\cf2 \
		window_type = 12 ;\
		windowsize = 0 ;\
\
		frames_per_second = 200 ;\
		\cf5 //( Suggestions below based on 200 frames per second)\cf2 \
\
		time_expansion_contraction_factor = 1 ;\
\
		\cf5 //**** OUTPUT CHANNEL(S) *******************************\cf2 \
		resynthesis_channel_1_to_max__0_all = 0 ;\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		oscillator_resynthesis_threshold_in_db = -96 ;\
\
		\cf5 //****** DYNAMIC PARAMETERS ****************************\cf2 \
		frequency_shift = 0 ;\
		gain_in_decibels = 0 ;\
		pitch_transposition_in_semitones = 0 ;\
\
		\cf5 //************ NOISE OR PITCH ***************************\cf2 \
\
		extract_periodic_0__noise_1 = 0 ;\
\
		\cf5 //************ COMPLEMENT SPECTRUM ***************************\cf2 \
\
		complement_spectrum_proportion = 0 ;\
\
\
		\cf5 //  A value of 1 produces the inversion of the current \cf2 \
		\cf5 //  compression/expansion settings given above. A value of \cf2 \
		\cf5 //  0 produces no change to the settings. Values in-between \cf2 \
		\cf5 //  0 and 1 interpolate between no change and the\cf2 \
		\cf5 //  inverted noise/pitch spectrum. \cf2 \
		\cf5 //\cf2 \
		\cf5 //  For example, if the settings above produced an (expanded) spectrum \cf2 \
		\cf5 //  highlighting the resonant parts of the sound, then a value \cf2 \
		\cf5 //  of 1  would produce its (compressed) complement of residual-noise \cf2 \
		\cf5 //  components. A function moving from 0-1 would create a crossfade \cf2 \
		\cf5 //  the original settings to their inversion or complement.\cf2 \
\
		freq_change_threshold_in_hz = 22 ;\
		\cf5 // For periodic, try 6-10; for noise, try 10 or greater.\cf2 \
\
\
		threshold_accumulator_response_time = 0.1 ;\
		\cf5 // Use 0 to 0.2\cf2 \
		\cf5 // In each bin, an average frequency is continuously accumulated \cf2 \
		\cf5 // using a lowpass filter. This parameter controls the speed \cf2 \
		\cf5 // at which this average responds to change.\cf2 \
\
		\cf5 //*********** AMPLITUDE CHANGE RESPONSE TIME *****************\cf2 \
		amplitude_change_response_time_in_seconds = 0.05 ;\
\
		\cf5 // Try anything from .1 to 1.; .4 for periodic. \cf2 \
		\cf5 // Use to smooth the turning on and off of components.\cf2 \
\
		\cf5 //************ SPECTRUM WARPSHAPE ****************************\cf2 \
		spectrum_warpshape_index = 0 ;\
\
		\cf5 //********* FRAME NORMALIZATION ******************************\cf2 \
\
		frame_normalization_decibel_limit = 0 ;\
		\cf5 // Scale the amplitudes of each output frame against the input frame\cf2 \
		\cf5 // using a scaling ratio formed from the sum of the input frame amplitudes\cf2 \
		\cf5 // over the sum of the output frame amplitudes limited by the decibel limit. \cf2 \
		\cf5 // Use 96 or less as needed; 0 prevents normalization. \cf2 \
\
		\cf5 //******** LOW/HIGH SHELF EQ ****\cf2 \
		low_shelf_eq_gain_in_decibels = -0 ;\
		low_shelf_eq_frequency = 500 ;\
\
		high_shelf_eq_gain_in_decibels = 0 ;\
		high_shelf_eq_frequency = 4000 ;\
\
		\cf5 //********** AMPLITUDE STATISTICS ********************** \cf2 \
		print_amplitude_statistics_0_no__1_yes = 1 ;\
		amplitude_statistics_time_interval = 1.0 ;\
\
\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "spectralextractor "\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -R"\cf2  ++ high_shelf_eq_frequency ++  \cf4 " -A"\cf2  ++ gain_in_decibels ++  \cf4 " -="\cf2  ++ rescale_level_in_decibels ++ \
			 \cf4 " -m"\cf2  ++ low_shelf_eq_frequency ++  \cf4 " -L"\cf2  ++ amplitude_change_response_time_in_seconds ++ \
			 \cf4 " -H"\cf2  ++ low_shelf_eq_gain_in_decibels ++  \cf4 " -W"\cf2  ++ spectrum_warpshape_index ++ \
			 \cf4 " -E"\cf2  ++ frame_normalization_decibel_limit ++  \cf4 " -c"\cf2  ++ complement_spectrum_proportion ++ \
			 \cf4 " -X"\cf2  ++ high_shelf_eq_gain_in_decibels ++  \cf4 " -C"\cf2  ++ resynthesis_channel_1_to_max__0_all ++ \
			 \cf4 " -_"\cf2  ++ auto_output_sound_file_play__repetitions ++  \cf4 " -p"\cf2  ++ print_amplitude_statistics_0_no__1_yes ++ \
			 \cf4 " -M"\cf2  ++ windowsize ++  \cf4 " -e"\cf2  ++ endtime ++  \cf4 " -g"\cf2  ++ threshold_accumulator_response_time ++ \
			 \cf4 " -a"\cf2  ++ frequency_shift ++  \cf4 " -w"\cf2  ++ window_type ++  \cf4 " -P"\cf2  ++ pitch_transposition_in_semitones ++ \
			 \cf4 " -t"\cf2  ++ oscillator_resynthesis_threshold_in_db ++  \cf4 " -N"\cf2  ++ fft_length ++ \
			 \cf4 " -Q"\cf2  ++ freq_change_threshold_in_hz ++  \cf4 " -b"\cf2  ++ begintime ++  \cf4 " -q"\cf2  ++ extract_periodic_0__noise_1 ++ \
			 \cf4 " -D"\cf2  ++ frames_per_second ++  \cf4 " -I"\cf2  ++ time_expansion_contraction_factor ++ \
			 \cf4 " -i"\cf2  ++ amplitude_statistics_time_interval\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ input_file ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
spectralextractor.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
)\
