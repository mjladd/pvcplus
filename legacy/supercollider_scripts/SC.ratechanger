{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf2 (\
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  ratechanger = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		new_imposed_sample_rate, \
		synthesize_duration__off_0__on_1, \
		output_file, \
		normalization, \
		rate_multiplier_as_a_function_of_input_sound_time, \
		pitch_shift_in_semitones_as_a_function_of_output_sound_time, \
		output_duration, \
		rate_multiplier_as_a_function_of_output_sound_time, \
		low_time_point_boundary, \
		data_time_point_origin, \
		sinc_function_truncation_decibel_level, \
		output_channel, \
		auto_output_sound_file_play__repetitions, \
		resynthesis_method__sinc_summation_0__rectangular_1__linear_interpolation_2, \
		number_of_lookup_table_values_per_pi_sine_period, \
		sinc_function__use_math_functions_0__lookup_table_1, \
		pitch_shift_in_semitones_as_a_function_of_input_sound_time, \
		high_time_point_boundary, \
		input_file, \
		amplitude_envelope_in_db_as_a_function_of_input_sound_time, \
		amplitude_envelope_in_db_as_a_function_of_output_sound_time\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //................ RATECHANGER .........................\cf2 \
		\cf5 //******************************************************\cf2 \
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		output_file = \cf4 "/tmp/output.au"\cf2  ;\
\
		\cf5 // The following may be used to copy a formatted\cf2 \
		\cf5 // sound file into the output location listed above.   \cf2 \
\
		\cf5 //cp ~/32bit.BLANK.au $output_file\cf2 \
\
\
		\cf5 //...............AUTO-PLAY OF OUTPUT FILE...............\cf2 \
		auto_output_sound_file_play__repetitions = -0 ;\
		\cf5 //(-2 = interactive: Play once, then prompts for more.)\cf2 \
		\cf5 //(-1 = interactive: Prompt for each play of file.)\cf2 \
		\cf5 //( 0 = off)\cf2 \
		\cf5 //( 1 or greater = Auto-repeat for specified repetitions.)\cf2 \
\
\
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
\
		input_file = \cf4 "~/mySound.wav"\cf2  ;\
\
		\cf5 //........ BEGIN/END TIMES .............................\cf2 \
\
\
		\cf5 //........... OUTPUT CHANNEL(S) .......................\cf2 \
		output_channel = 1 ;\
		\cf5 // (channels are numbered from 1 to the maximum.)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		\cf5 //............ OUTPUT DURATION .........................\cf2 \
\
		output_duration = 0 ;\
		\cf5 //\cf2 \
		\cf5 // Duration of 0. or less triggers synthesis of duration.\cf2 \
		\cf5 // (See below.)\cf2 \
\
		synthesize_duration__off_0__on_1 = 0 ;\
		\cf5 //\cf2 \
		\cf5 // Synthesize an output duration that is synchronous with the \cf2 \
		\cf5 // crossing of a boundary and the completion of control \cf2 \
		\cf5 // functions. Unset low and high boundaries default to the\cf2 \
		\cf5 // input sounds begin and end times.\cf2 \
\
		\cf5 //............ DATA TIME CONTROL .........................\cf2 \
\
		data_time_point_origin = 0.0 ;\
\
		\cf5 // ** Dynamic Control Via Input and Output Time **\cf2 \
\
		\cf5 // The following parameters allow for the dynamic control of rate and amplitude\cf2 \
		\cf5 // as a function of either the current input or output sound time. The respective\cf2 \
		\cf5 // controls may be used simultaneously, such as in a case in which a pitch\cf2 \
		\cf5 // correction function is driven according to the input sound correction needing\cf2 \
		\cf5 // to be synchronized with the input sound: while a second function is used to apply\cf2 \
		\cf5 // pitch changes as a function of the output time and a synthesized output duration.\cf2 \
\
		\cf5 // ** Rate Change Control **\cf2 \
\
		rate_multiplier_as_a_function_of_output_sound_time = 1 ;\
		rate_multiplier_as_a_function_of_input_sound_time = 1 ;\
		\cf5 // Set to 1 for no change. \cf2 \
\
		pitch_shift_in_semitones_as_a_function_of_output_sound_time = 0 ;\
		pitch_shift_in_semitones_as_a_function_of_input_sound_time = 0 ;\
		\cf5 // Set to 0 for no change. \cf2 \
\
		\cf5 //............ GAIN CONTROL .........................\cf2 \
\
		amplitude_envelope_in_db_as_a_function_of_input_sound_time = 0 ;\
		amplitude_envelope_in_db_as_a_function_of_output_sound_time = 0 ;\
		\cf5 //\cf2 \
\
\
		addCommand.value(\
			\cf4 " #"\cf2 \
		) ;\
\
		\cf5 //............ SINC FUNCTION .........................\cf2 \
\
		sinc_function_truncation_decibel_level = -60 ;\
		\cf5 //\cf2 \
		\cf5 // The specified level determines the sinc window truncation point\cf2 \
		\cf5 // using the amount of dB rolloff; lower levels increase fidelity\cf2 \
		\cf5 // while increasing computation, since they increase the sinc function\cf2 \
		\cf5 // width, which increases the number of overlapping sinc functions\cf2 \
		\cf5 // to be scaled and summed. \cf2 \
		\cf5 // Range: -10 to -96\cf2 \
\
		sinc_function__use_math_functions_0__lookup_table_1 = 1 ;\
		\cf5 //\cf2 \
		\cf5 // Sinc function may be computed using math functions or\cf2 \
		\cf5 // a pre-determined lookup table and linear interpolation.\cf2 \
		\cf5 // Table mode is effectively equivalent to math functions, \cf2 \
		\cf5 // while offering faster computation.\cf2 \
\
		number_of_lookup_table_values_per_pi_sine_period = 100 ;\
		\cf5 //\cf2 \
		\cf5 // For setting of the lookup table size according to the\cf2 \
		\cf5 // number of values per Pi radian.\cf2 \
		\cf5 // \cf2 \
\
		\cf5 //............ DATA BOUNDARIES .........................\cf2 \
\
		low_time_point_boundary = 0 ;\
		high_time_point_boundary = 0 ;\
		\cf5 //\cf2 \
		\cf5 // Low boundary of 0 or less defaults to 0.\cf2 \
		\cf5 // High boundary of 0 or less defaults to input file end.\cf2 \
\
		\cf5 //............ NORMALIZATION .........................\cf2 \
\
		normalization = 1 ;\
		\cf5 //\cf2 \
		\cf5 // 0: Do not normalize. \cf2 \
		\cf5 // 1: Normalize channels to input levels.\cf2 \
		\cf5 // 2: Normalize channels independently.\cf2 \
		\cf5 // 3: Normalize channels together against channel with peak amplitude.\cf2 \
		\cf5 // 4: Normalize channels together if any channel exceeds 0 decibels.\cf2 \
\
		\cf5 //............ RE-SYNTHESIS METHOD .........................\cf2 \
\
		resynthesis_method__sinc_summation_0__rectangular_1__linear_interpolation_2 = 0 ;\
		\cf5 //\cf2 \
		\cf5 // Mode 0 is the default standard, being the sole purpose of the routine. \cf2 \
		\cf5 // Modes 1 and 2, which produce digital artifacts--aliasing, etc., are provided\cf2 \
		\cf5 // for demonstration and educational purposes ONLY.\cf2 \
		\cf5 //\cf2 \
\
		\cf5 //............ IMPOSED SAMPLE RATE .........................\cf2 \
\
		new_imposed_sample_rate = 44100 ;\
\
		\cf5 // New sample rate imposed onto the output sound. \cf2 \
		\cf5 // Values of zero or less default to the old sample rate. \cf2 \
		\cf5 // To convert the sound file sample rate without changing its sound, \cf2 \
		\cf5 // (i.e. to resample the input signal according to a new sample rate),\cf2 \
		\cf5 // specify, along with a new sample rate (-m), a rate change multiplier that resamples\cf2 \
		\cf5 // the signal in accord with the new and old sample rates i.e. for either -r or -R, \cf2 \
		\cf5 // specify a value equal to the [old-sample-rate / new-sample-rate] .\cf2 \
\
\
		\cf5 //======================================================\cf2 \
		\cf5 //========= SCRATCH SPACE ==============================\cf2 \
		\cf5 //======================================================\cf2 \
\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "ratechanger"\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -C"\cf2  ++ output_channel ++  \cf4 " -D"\cf2  ++ synthesize_duration__off_0__on_1 ++  \cf4 " -r"\cf2  ++ rate_multiplier_as_a_function_of_input_sound_time ++ \
			 \cf4 " -s"\cf2  ++ pitch_shift_in_semitones_as_a_function_of_input_sound_time ++  \cf4 " -b"\cf2  ++ low_time_point_boundary ++ \
			 \cf4 " -O"\cf2  ++ data_time_point_origin ++  \cf4 " -t"\cf2  ++ sinc_function__use_math_functions_0__lookup_table_1 ++ \
			 \cf4 " -m"\cf2  ++ new_imposed_sample_rate ++  \cf4 " -X"\cf2  ++ resynthesis_method__sinc_summation_0__rectangular_1__linear_interpolation_2 ++ \
			 \cf4 " -S"\cf2  ++ pitch_shift_in_semitones_as_a_function_of_output_sound_time ++  \cf4 " -a"\cf2  ++ amplitude_envelope_in_db_as_a_function_of_input_sound_time ++ \
			 \cf4 " -A"\cf2  ++ amplitude_envelope_in_db_as_a_function_of_output_sound_time ++  \cf4 " -B"\cf2  ++ sinc_function_truncation_decibel_level ++ \
			 \cf4 " -d"\cf2  ++ output_duration ++  \cf4 " -e"\cf2  ++ high_time_point_boundary ++  \cf4 " -R"\cf2  ++ rate_multiplier_as_a_function_of_output_sound_time ++ \
			 \cf4 " -_"\cf2  ++ auto_output_sound_file_play__repetitions ++  \cf4 " -n"\cf2  ++ normalization ++ \
			 \cf4 " -L"\cf2  ++ number_of_lookup_table_values_per_pi_sine_period\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ input_file ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
ratechanger.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
)\
}