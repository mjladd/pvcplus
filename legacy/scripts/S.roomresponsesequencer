#!/bin/sh
#******************************************************
#................ ROOM RESPONSE SEQUENCER .................
#******************************************************

#******************** OUTPUT **************************
# Roomresponsesequencer creates a sequence of synthesized
# impulse responses using roomresponsemaker; the responses
# are used by irconvolversequencer, which convolves them with 
# a series of sound crossfade segments and sequences their mix, 
# using mixfiles, to create a room impulse response transition,
# reflecting the movement of the source, its changes, and any change
# to the space responding to it. 
#
# To serve the making of these transitions, many of the 
# roomresponsemaker parameters used at each iteration 
# can be expressed as functions articulating the parameter's 
# change across the transition. Central to the transition is the concept of
# source sound movement (specified using separate
# X and Y coordinate origin and rotation functions), defining a 
# movement path, and a movement function, defining the source's 
# travel along the path. 

output_directory=/tmp/rr
# Common directory for collecting impulse responses.  

output_impulse_response_sound_format_template_file=~/32bit.BLANK.au
# Template sound file whose format is used to create impulse response files. 

#...............AUTO-PLAY OF OUTPUT FILE...............
auto_output_sound_file_play__repetitions=-0
#(-2 = interactive: (Play once, then prompts for more.)
#(-1 = interactive: (Prompt for each play of file.)
#( 0 = off)
#( 1 or greater = Auto-repeat for specified repetitions.)




#........... OUTPUT CHANNEL(S) .......................
output_channel=0
# (channels are numbered from 1 to the maximum.)
# (0 = all channels)



#******************************************************
#............. POLYGON ROOM .........................
#******************************************************
# 
# Room polygon may be input using coordinates, either Cartesian or polar,
# or may be synthesized using the parameters below.  

polygon_coordinates__synthesized_0__Cartesian_file_1__polar_file_2=0 

polygonal_room_coordinates_file=/tmp/polygonCoordinates
#
# File of ascii room corner coordinates. Cartesian grid is oriented to listener
# with positive Y to listener's front and negative and positive X dimensions
# extending to the listener's respective left and right side. Polar coordinates 
# are oriented with an angle of 0 degrees positioned to the listener's right side 
# and positive angles rotating counter-clockwise. Successive coordinates are 
# connected together, with the last connected back to the first, to make 
# what must be a polygonal space; wall segments must not cross and the origin at [0, 0]
# must be within the space, both of which will be checked and fatally flagged 
# if in error. 


echo -30 30    30 30   30 -30   -300 -30 > /tmp/polygonCoordinates


#******************************************************
#.......POLYGON ROOM SYNTHESIS PARAMETERS ............
#******************************************************
# Room corners are synthesized using a collection of polar radii extending
# out from the origin to the prospective corners of the room. Radial distance
# to the corners is randomly determined by minimum and maximum distances, with 
# the subtending angles being designed to be uniform or randomly different, 
# with the degree of non-uniformity controlled through an angle regularity 
# proportion. Polar orientation of synthesis region is with 0 degrees 
# to the listener's right with positive angles extending counter-clockwise.
# A rotation factor is available during the initial synthesis phase. 
# Further modification of rooms coordinates, be they synthesized or specified, 
# is available below. 

number_of_walls=7
# (func)


