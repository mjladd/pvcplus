# (func)
# 

# As example, the following functions create a single rotation,
# back to front to back (left-to-right), with an origin that
# shifts from left to right. 

gen4 -L1000 0 90 0 1 450 > /tmp/angle

gen4 -L1000 0 -4 0 1 4  > /tmp/xSourceCoordinates

normalized_sound_path_movement_function__0_to_1=/tmp/move

gen4 -L1000 0 0 0 1 1 > /tmp/move


