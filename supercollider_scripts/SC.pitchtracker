{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf2 (\
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  pitchtracker = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		windowsize, \
		method_on_multiple_channels__average_0__peak_1, \
		low_freq_or_pitch_boundary, \
		amplitude_weighted_oversampling_factor, \
		analysis_channel_1_to_max, \
		amplitude_envelope_warp, \
		reference_frequency_or_pitch, \
		ouput_trajectory_sample_rate, \
		release_time_in_seconds, \
		detection_method__0_1_or_2, \
		plot_output__1_yes__0_no, \
		output_trajectory_data_type, \
		gate_threshold_in_decibels, \
		fft_length, \
		detection_window_size_maximum, \
		begintime, \
		endtime, \
		detection_threshold_in_decibels, \
		analysis_frames_per_second, \
		detection_window_size_minimum, \
		mode_filter_window_size_in_seconds, \
		pitch_trajectory_output_file, \
		decibels_of_compression, \
		compression_threshold_in_decibels, \
		frequency_response_time, \
		sndfile, \
		attack_time_in_seconds, \
		output_units, \
		high_freq_or_pitch_boundary\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //*********** PITCHTRACKER *****************************\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //  THIS IS A WORK-IN-PROGRESS. IT WORKS RATHER WELL,  \cf2 \
		\cf5 //   ALTHOUGH,  LIKE ALL PITCH TRACKING,  HAS ITS \cf2 \
		\cf5 //   INEXPLICABLE MOMENTS--NEEDS MORE WORK ON BACK-TRACING\cf2 \
		\cf5 //   THE PITCH OF ONSETS. \cf2 \
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		pitch_trajectory_output_file = \cf4 "/tmp/p"\cf2  ;\
\
		plot_output__1_yes__0_no = 0 ;\
\
		\cf5 //******************************************************\cf2 \
		\cf5 //************ OUTPUT SETTINGS ************************\cf2 \
\
		\cf5 //......... OUTPUT UNITS ............................ \cf2 \
\
		output_units = 0 ;\
		\cf5 // 0: freq\cf2 \
		\cf5 // 1: octdec\cf2 \
		\cf5 // 2: semitone deviation from reference\cf2 \
		\cf5 // 3: inverted semitones of deviation from reference\cf2 \
		\cf5 // 4: MIDI\cf2 \
		\cf5 // 5: octave.pitchclass\cf2 \
\
\
		\cf5 //.........REFERENCE FREQUENCY ............................ \cf2 \
\
		reference_frequency_or_pitch = 880 ;\
		\cf5 //\cf2 \
		\cf5 // for use with output formats 2 or 3 -- see above\cf2 \
		\cf5 // Values less than 12 are treated as octave.pitchclass.\cf2 \
		\cf5 // Function file of changing frequencies may be used with\cf2 \
		\cf5 // inverted semitones of deviation to produce correction \cf2 \
		\cf5 // files that impose reference frequency tracking onto sound.\cf2 \
\
\
		\cf5 //........OUTPUT SAMPLE RATE ............................ \cf2 \
\
		ouput_trajectory_sample_rate = 200 ;\
		\cf5 //\cf2 \
		\cf5 // Must be equal to or greater than analysis frame rate. \cf2 \
\
\
		\cf5 //........OUTPUT DATA TYPE ............................ \cf2 \
\
		output_trajectory_data_type = 1 ;\
		\cf5 //( 0: ascii )\cf2 \
		\cf5 //( 1: 32-bit floats )\cf2 \
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
		sndfile = \cf4 "/tmp/sine.au"\cf2  ;\
\
		\cf5 //........ BEGIN/END TIMES .............................\cf2 \
\
		begintime = 0.0 ;\
		endtime = -1 ;\
\
		analysis_frames_per_second = 200 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
		fft_length = 4096 ;\
		windowsize = 0 ;\
\
		\cf5 //*************** CHANNELS ****************************\cf2 \
		analysis_channel_1_to_max = 1 ;\
\
		method_on_multiple_channels__average_0__peak_1 = 0 ;\
		\cf5 //******************************************************\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //*********** DETECTION PARAMETERS *********************\cf2 \
		\cf5 //======================================================\cf2 \
\
		\cf5 //......... DETECTION METHOD ........................... \cf2 \
\
		detection_method__0_1_or_2 = 0 ;\
\
		\cf5 // 0 = the strongest formant, or the lowest harmonic\cf2 \
		\cf5 //	 fundamental of it, detected within the frequency \cf2 \
		\cf5 //	 and amplitude limits.\cf2 \
		\cf5 // 1 = the strongest formant\cf2 \
		\cf5 // 2 = band-limited centroid\cf2 \
		\cf5 //	 Takes the amplitude (squared) weighted average of \cf2 \
		\cf5 //	 the spectrum between the low-high boundaries.\cf2 \
\
		\cf5 //******************************************************\cf2 \
\
		\cf5 //......... DETECTION BOUNDARIES ....................... \cf2 \
\
		low_freq_or_pitch_boundary = 100 ;\
		high_freq_or_pitch_boundary = 1000 ;\
		\cf5 //Values less than 12 are treated as octave.pitchclass. \cf2 \
\
		\cf5 // . . . . . MODE FILTER: FIRST PASS . . . \cf2 \
\
		mode_filter_window_size_in_seconds = 1.0 ;\
		\cf5 //\cf2 \
		\cf5 // To limit non-uniform spikes, set time window \cf2 \
		\cf5 // to a duration large enough to invoke a common value\cf2 \
		\cf5 // region that will suppress deviant values or departures\cf2 \
		\cf5 // from the current norm. \cf2 \
\
		\cf5 //......... DETECTION TIME WINDOW -- SECOND PASS \cf2 \
\
		detection_window_size_minimum = 0.01 ;\
		detection_window_size_maximum = 0.05 ;\
		\cf5 // (Keep range between .05 and .2, "I guess".....)\cf2 \
		\cf5 // Functions like a mode filter--see above. \cf2 \
\
\
		\cf5 //......... DETECTION THRESHOLD ....................... \cf2 \
\
		detection_threshold_in_decibels = -50 ;\
		\cf5 //( -10 to -20, perhaps? ) ; \cf2 \
\
		\cf5 //****** FREQUENCY TRAJECTORY ***********************\cf2 \
\
		\cf5 //......... PITCH TRAJECTORY SMOOTHING ................. \cf2 \
\
		frequency_response_time = 0.1 ;\
\
\
		\cf5 // Lowpass filter that smooths the changes to the tracked \cf2 \
		\cf5 // pitch trajectory; larger values increase smoothness.\cf2 \
		\cf5 // 0 == off. \cf2 \
\
		\cf5 //........ AMPLITUDE WEIGHTED RESAMPLING ............\cf2 \
\
		amplitude_weighted_oversampling_factor = 0 ;\
\
		\cf5 //\cf2 \
		\cf5 // Each value in the pitch trajectory will be over-sampled  \cf2 \
		\cf5 // up to an amplitude-determined proportion of the specified \cf2 \
		\cf5 // amount. For use in identifying the strongest median\cf2 \
		\cf5 // frequency. For normal pitch tracking, set to 0, which\cf2 \
		\cf5 // will prevent oversampling. \cf2 \
\
\
		\cf5 //***** AMPLITUDE ENVELOPE **************************\cf2 \
\
		\cf5 //........RESPONSE TIME ............................ \cf2 \
		release_time_in_seconds = 0.0 ;\
		attack_time_in_seconds = 0.0 ;\
\
		\cf5 //........ COMPRESSOR ............................... \cf2 \
		compression_threshold_in_decibels = -0 ;\
		decibels_of_compression = -0 ;\
\
		\cf5 //........GATE ..................................... \cf2 \
		gate_threshold_in_decibels = -80 ;\
\
		\cf5 //........WARP ....................................... \cf2 \
		amplitude_envelope_warp = 0 ;\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "pitchtracker"\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -P"\cf2  ++ plot_output__1_yes__0_no ++  \cf4 " -g"\cf2  ++ output_trajectory_data_type ++ \
			 \cf4 " -f"\cf2  ++ low_freq_or_pitch_boundary ++  \cf4 " -D"\cf2  ++ analysis_frames_per_second ++ \
			 \cf4 " -C"\cf2  ++ analysis_channel_1_to_max ++  \cf4 " -m"\cf2  ++ detection_method__0_1_or_2 ++ \
			 \cf4 " -j"\cf2  ++ detection_window_size_minimum ++  \cf4 " -d"\cf2  ++ detection_threshold_in_decibels ++ \
			 \cf4 " -a"\cf2  ++ frequency_response_time ++  \cf4 " -M"\cf2  ++ windowsize ++  \cf4 " -o"\cf2  ++ reference_frequency_or_pitch ++ \
			 \cf4 " -F"\cf2  ++ high_freq_or_pitch_boundary ++  \cf4 " -G"\cf2  ++ decibels_of_compression ++ \
			 \cf4 " -N"\cf2  ++ fft_length ++  \cf4 " -J"\cf2  ++ detection_window_size_maximum ++  \cf4 " -O"\cf2  ++ output_units ++ \
			 \cf4 " -L"\cf2  ++ release_time_in_seconds ++  \cf4 " -T"\cf2  ++ compression_threshold_in_decibels ++ \
			 \cf4 " -l"\cf2  ++ attack_time_in_seconds ++  \cf4 " -H"\cf2  ++ mode_filter_window_size_in_seconds ++ \
			 \cf4 " -r"\cf2  ++ ouput_trajectory_sample_rate ++  \cf4 " -W"\cf2  ++ amplitude_envelope_warp ++ \
			 \cf4 " -X"\cf2  ++ method_on_multiple_channels__average_0__peak_1 ++  \cf4 " -S"\cf2  ++ gate_threshold_in_decibels ++ \
			 \cf4 " -b"\cf2  ++ begintime ++  \cf4 " -p1"\cf2  ++  \cf4 " -E"\cf2  ++ amplitude_weighted_oversampling_factor ++ \
			 \cf4 " -e"\cf2  ++ endtime\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ sndfile ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ pitch_trajectory_output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
pitchtracker.value( iterations: 1 ) ; \
\
runCommands.value ;\
\
\
\cf4 "..........DONE!"\cf2  \
)\
}