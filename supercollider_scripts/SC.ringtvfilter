{\rtf1\ansi\ansicpg1252\cocoartf1265\cocoasubrtf210
\cocoascreenfonts1{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;\red0\green0\blue0;\red0\green0\blue191;\red96\green96\blue96;
\red191\green0\blue0;}
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural

\f0\fs24 \cf2 (\
\
\cf3 var\cf2  addCommand = \{ \cf3 arg\cf2  command ;\
	command = command.replace( \cf4 "\\n"\cf2 , \cf4 " "\cf2  ).replace( \cf4 "\\t"\cf2 , \cf4 " "\cf2  ) ;  \
	commands = commands ++ command ++ \cf4 " \\n"\cf2  ; \
\} ; \
\
\
\
\cf3 var\cf2  runCommands = \{\
	\cf3 var\cf2  homeDirectory ; \
	homeDirectory =  \cf4 "HOME"\cf2 .getenv ;\
	commands = commands.replace( \cf4 "~/"\cf2 , homeDirectory ++ \cf4 "/"\cf2  ) ;\
	commands.replace(  \cf4 "\\n"\cf2 , \cf4 " ;\\n\\n"\cf2  ).postln  ; \
	commands.runInTerminal ; \
\} ; \
\
\cf3 var\cf2  commands=\cf4 ""\cf2  ;\
\
\cf3 var\cf2  ringtvfilter = \{ \cf3 arg\cf2  iterations=1 ; \
\
	\cf3 var\cf2  temp,\
		dataString, \
		commandLines=\cf4 ""\cf2 , \
		reverb_filter_on_input_0__feedback_1, \
		reverb_output_high_shelf_eq_frequency, \
		reverb_filter_file, \
		reverb_gain_in_decibels, \
		input_file, \
		output_channel, \
		reverb_feedback_low_shelf_eq_gain_in_decibels, \
		sampler_loop_mode__wrap_0__fold_1__clip_2, \
		reverb_feedback_eq_decay_time_in_seconds, \
		oscillator_resynthesis_threshold_in_db, \
		reverb_random_freq_deviation_proportion, \
		reverb_feedback_eq_signal_balance_gain_limiter_in_db, \
		p_change_select__source_only_0__both_source_and_filter_1, \
		filter_spectrum_decibels_of_compression, \
		reverb_filter_transposition_in_semitones, \
		fft_length, \
		mode__sampler_loop_0__autostop_1, \
		analysis_channel, \
		begintime, \
		reverb_random_deviation_response_time_in_seconds, \
		reverb_feedback_high_shelf_eq_gain_in_decibels, \
		windowsize, \
		reverb_feedback_filter_decay_time_in_seconds, \
		reverb_output_low_shelf_eq_frequency, \
		auto_output_sound_file_play__repetitions, \
		reverb_filter_spectrum_warpshape, \
		output_file, \
		onset_and_release_segment_mode__off_0__on_1, \
		reverb_input_envelope_attack_time_in_seconds, \
		filter_rate_multiplier, \
		source_gain_in_decibels, \
		filter_lower_time_boundary, \
		reverb_input_high_shelf_eq_frequency, \
		reverb_filter_source_db, \
		reverb_pitch_transposition_in_semitones, \
		reverb_output_low_shelf_eq_gain_in_decibels, \
		source_frequency_shift, \
		reverb_input_low_shelf_eq_gain_in_decibels, \
		endtime, \
		reverb_feedback_low_shelf_eq_frequency, \
		reverb_input_envelope_release_time_in_seconds, \
		filter_spectrum_compression_threshold_in_decibels, \
		reverb_feedback_high_shelf_eq_frequency, \
		reverb_output_high_shelf_eq_gain_in_decibels, \
		amplitude_statistics_time_interval, \
		print_amplitude_statistics_0_no__1_yes, \
		frames_per_second, \
		reverb_frequency_shift, \
		normalize_loop_amplitudes__off_0__on_1, \
		rescale_level_in_decibels, \
		filter_time_point_origin, \
		reverb_threshold_in_db, \
		reverb_input_low_shelf_eq_frequency, \
		reverb_decay_time_in_seconds, \
		window_type, \
		filter_upper_time_boundary, \
		loop_smooth_time_in_seconds, \
		reverb_filter_shift, \
		source_pitch_transposition_in_semitones, \
		reverb_input_high_shelf_eq_gain_in_decibels, \
		time_expansion_contraction_factor\
	; \
		\cf5 // *** INTERNAL FUNCTION FOR SETTING ROUTINE VARIABLES ***\cf2 \
\
	\cf3 var\cf2  setRoutineVariables = \{\cf3 arg\cf2  iteration=0 ;  \
\
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
		\cf5 //******************************************************\cf2 \
		\cf5 //................... RINGTVFILTER .....................\cf2 \
		\cf5 //******************************************************\cf2 \
\
\
		\cf5 //******************** OUTPUT **************************\cf2 \
\
		output_file = \cf4 "/tmp/output.au"\cf2  ;\
\
		\cf5 // The following may be used to copy a formatted\cf2 \
		\cf5 // sound file into the output location listed above.   \cf2 \
\
		\cf5 //cp ~/32bit.BLANK.au $output_file\cf2 \
\
		\cf5 //...............AUTO-PLAY OF OUTPUT FILE...............\cf2 \
		auto_output_sound_file_play__repetitions = 0 ;\
		\cf5 //(-2 = interactive: Play once, then prompts for more.)\cf2 \
		\cf5 //(-1 = interactive: Prompt for each play of file.)\cf2 \
		\cf5 //( 0 = off)\cf2 \
		\cf5 //( 1 or greater = Auto-repeat for specified repetitions.)\cf2 \
\
		\cf5 //................ RESCALE .............................\cf2 \
\
		rescale_level_in_decibels = 0 ;\
		\cf5 //(-96 to 0 dB. )\cf2 \
		\cf5 //(Set to 1 to rescale to peak of input file.)\cf2 \
		\cf5 //(Set to 2 to bypass rescale.)\cf2 \
\
\
		\cf5 //******************** INPUT ***************************\cf2 \
\
		\cf5 //............. REVERB FILTER FILE .....................\cf2 \
		\cf5 // A pvanalysis file. \cf2 \
\
		reverb_filter_file = \cf4 "~/pvanalysis"\cf2  ;\
\
		\cf5 //............. SOUND FILE .............................\cf2 \
\
		\cf5 //input_file=~/cymbal.crash.au\cf2 \
		\cf5 //input_file=~/voice.NF.aiff\cf2 \
		\cf5 //input_file=~/cymbal.crash.aiff\cf2 \
		\cf5 //input_file=~/guitar.au\cf2 \
		input_file = \cf4 "~/WaterSounds/water10.au"\cf2  ;\
\
		\cf5 //........ BEGIN/END TIMES .............................\cf2 \
\
		begintime = 0 ;\
		endtime = 0 ;\
		\cf5 // (0 end time defaults to end of file)\cf2 \
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** ANALYSIS PARAMETERS ******************************\cf2 \
\
		fft_length = 4096 ;\
		window_type = 16 ;\
		windowsize = 0 ;\
\
		\cf5 //( Use larger FFT sizes for ring routines.)\cf2 \
\
		frames_per_second = 200 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //*** RESYNTHESIS PARAMETERS ***************************\cf2 \
\
		\cf5 //........... OUTPUT CHANNEL(S) .......................\cf2 \
		output_channel = 0 ;\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		\cf5 //.............OSCIL THRESHOLD ........................\cf2 \
\
		oscillator_resynthesis_threshold_in_db = -96 ;\
\
		\cf5 //****************** MODIFICATIONS *********************\cf2 \
\
		\cf5 //.................. TIME ..............................\cf2 \
\
		time_expansion_contraction_factor = 1 ;\
\
\
		\cf5 //******************************************************\cf2 \
		\cf5 //.......... SOURCE PARAMETERS .........................\cf2 \
		\cf5 //******************************************************\cf2 \
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		source_gain_in_decibels = -96 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		source_frequency_shift = 0 ;\
		source_pitch_transposition_in_semitones = 0 ;\
\
		\cf5 //******************************************************\cf2 \
		\cf5 //.......... REVERB PARAMETERS ........................\cf2 \
		\cf5 //******************************************************\cf2 \
\
		\cf5 //...REVERB OUTPUT CONTROLS ** y(n) ***...............\cf2 \
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		reverb_gain_in_decibels = 0 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		reverb_frequency_shift = 0 ;\
		reverb_pitch_transposition_in_semitones = 0 ;\
		p_change_select__source_only_0__both_source_and_filter_1 = 0 ;\
		\cf5 //((0) applies pitch changes before feedback filter, (1) after)\cf2 \
\
\
		\cf5 //-----------------------------------------------------\cf2 \
		\cf5 //........... OUTPUT EQ .............................. \cf2 \
		reverb_output_low_shelf_eq_gain_in_decibels = -0 ;\
		reverb_output_low_shelf_eq_frequency = 60 ;\
		reverb_output_high_shelf_eq_gain_in_decibels = -0 ;\
		reverb_output_high_shelf_eq_frequency = 100 ;\
		\cf5 //-----------------------------------------------------\cf2 \
\
\
\
		\cf5 //-----------------------------------------------------\cf2 \
		\cf5 //......... RANDOM  FREQUENCY DEVIATION.................\cf2 \
		reverb_random_freq_deviation_proportion = 0.0 ;\
		reverb_random_deviation_response_time_in_seconds = 0 ;\
		\cf5 //-----------------------------------------------------\cf2 \
\
\
		\cf5 //=====================================================\cf2 \
\
		\cf5 //...REVERB INPUT CONTROLS ** x(n) ***..................\cf2 \
\
		\cf5 //........... INPUT THRESHOLD CONTROLS .................\cf2 \
\
		reverb_threshold_in_db = -90 ;\
		\cf5 // If the amplitude of source bins lie above the threshold,\cf2 \
		\cf5 // then they are passed or input in the reverb path. \cf2 \
\
		\cf5 //------------------------------------------------------\cf2 \
		\cf5 //*** REVERB INPUT x(n) ENVELOPE RESPONSE\cf2 \
\
		reverb_input_envelope_release_time_in_seconds = 0 ;\
		reverb_input_envelope_attack_time_in_seconds = 0 ;\
\
		\cf5 //-----------------------------------------------------\cf2 \
		\cf5 //........... INPUT EQ .............................. \cf2 \
		reverb_input_low_shelf_eq_gain_in_decibels = -30 ;\
		reverb_input_low_shelf_eq_frequency = 500 ;\
		reverb_input_high_shelf_eq_gain_in_decibels = 0 ;\
		reverb_input_high_shelf_eq_frequency = 2000 ;\
		\cf5 //-----------------------------------------------------\cf2 \
\
		\cf5 //=====================================================\cf2 \
		\cf5 //...REVERB FEEDBACK CONTROLS ** y(n-1) ***............\cf2 \
\
		\cf5 //.................MASTER DECAY TIME..................\cf2 \
		reverb_decay_time_in_seconds = 5 ;\
		\cf5 //( This is a master decay time control.)\cf2 \
\
		\cf5 //.............FEEDBACK EQ DECAY TIME.................\cf2 \
		reverb_feedback_eq_decay_time_in_seconds = 5 ;\
		\cf5 //( This controls the decay into the feedback eq.)\cf2 \
\
		\cf5 //-----------------------------------------------------\cf2 \
		\cf5 //........... FEEDBACK_EQ .............................. \cf2 \
		reverb_feedback_low_shelf_eq_gain_in_decibels = 0 ;\
		reverb_feedback_low_shelf_eq_frequency = 300 ;\
		reverb_feedback_high_shelf_eq_gain_in_decibels = -0 ;\
		reverb_feedback_high_shelf_eq_frequency = 2000 ;\
		\cf5 //-----------------------------------------------------\cf2 \
\
		\cf5 //............BALANCE...................................\cf2 \
		reverb_feedback_eq_signal_balance_gain_limiter_in_db = 0 ;\
		\cf5 //(0 to 96dB, 0 = balancing off full limiting), \cf2 \
		\cf5 //               96 = balance full-on (no limiting)\cf2 \
\
\
\
		\cf5 //-----------------------------------------------------\cf2 \
		\cf5 //....................TV FILTER .......................\cf2 \
		\cf5 //-----------------------------------------------------\cf2 \
\
\
		\cf5 //............. ANALYSIS CHANNEL(S) ..................\cf2 \
		analysis_channel = 0 ;\
\
		\cf5 // (channels are numbered from 1-maximum)\cf2 \
		\cf5 // (0 = all channels)\cf2 \
\
		\cf5 //.................FILTER PLACEMENT...................\cf2 \
\
		reverb_filter_on_input_0__feedback_1 = 0 ;\
\
		\cf5 //( Set this to apply the freqresponse to the input xn), \cf2 \
		\cf5 //  or the feedback return y(n-1). When applied to the \cf2 \
		\cf5 // return, set the decay time below.\cf2 \
\
		\cf5 //..............FILTER DECAY TIME........................\cf2 \
\
		reverb_feedback_filter_decay_time_in_seconds = 5 ;\
\
		\cf5 //.................. DECIBELS ..........................\cf2 \
\
		reverb_filter_source_db = -96 ;\
\
		\cf5 //.................. PITCH .............................\cf2 \
\
		reverb_filter_transposition_in_semitones = 0 ;\
		reverb_filter_shift = -0 ;\
\
		\cf5 //............ SPECTRUM WARPSHAPE ......................\cf2 \
\
		reverb_filter_spectrum_warpshape = 0 ;\
\
\
\
		\cf5 //-----------------------------------------------------\cf2 \
		\cf5 //................ FILTER TIME.........................\cf2 \
		filter_time_point_origin = 0 ;\
		filter_rate_multiplier = 1 ;\
\
		\cf5 //........... TIME BOUNDARIES AND SAMPLER LOOP MODE ..............\cf2 \
\
		\cf5 // The low/high data time boundaries serve as either auto-stop\cf2 \
		\cf5 // boundaries that terminate synthesis at the crossing of a \cf2 \
		\cf5 // data time boundary or as sampler loop points to which can \cf2 \
		\cf5 // be added pre-loop and post-loop onset and release segments. \cf2 \
\
		filter_lower_time_boundary = 0 ;\
		filter_upper_time_boundary = -1 ;\
\
		\cf5 // -1 for low defaults to 0.0 and for high to analysis file duration.\cf2 \
\
		mode__sampler_loop_0__autostop_1 = 1 ;\
\
		\cf5 // In autostop mode, synthesis terminates with crossing of \cf2 \
		\cf5 // a time boundary. In sampler loop mode, time boundaries \cf2 \
		\cf5 // function as sampler loop points. \cf2 \
\
\
		sampler_loop_mode__wrap_0__fold_1__clip_2 = 0 ;\
\
		\cf5 // In Sampler Loop Mode, all timepoints are constrained to\cf2 \
		\cf5 // region between boundaries using the specified method.  \cf2 \
		\cf5 // 0: Wrap time into loop range. (/////)\cf2 \
		\cf5 // 1: Fold time into loop range. (/\\/\\/\\/\\)\cf2 \
		\cf5 // 2: Clip or limit time to the nearest boundary. (\\____)\cf2 \
\
\
		onset_and_release_segment_mode__off_0__on_1 = 0 ;\
\
		\cf5 // Setting onset/release mode in Sampler Mode causes looping\cf2 \
		\cf5 // to be preceded by a pre-loop/onset and a post-loop/release \cf2 \
		\cf5 // segment. The data time origin is initialized to 0.0 and \cf2 \
		\cf5 // progresses according to data time controls. The first entrance\cf2 \
		\cf5 // into the loop region triggers loop mode, which is maintained\cf2 \
		\cf5 // until trigger of the release segment. The release segment\cf2 \
		\cf5 // progresses from the current loop point to the analysis data\cf2 \
		\cf5 // end time, conforming to the data time rate control and specified\cf2 \
		\cf5 // synthesis duration. \cf2 \
\
		normalize_loop_amplitudes__off_0__on_1 = 0 ;\
\
		\cf5 // Set to 1, amplitudes in loop range are normalized to peak \cf2 \
		\cf5 // amplitude of low/high boundary frames. Onset and release \cf2 \
		\cf5 // segments are ramped in and out of loop range gain change \cf2 \
		\cf5 // as needed.  \cf2 \
\
\
		loop_smooth_time_in_seconds = 0.0 ;\
\
		\cf5 // Loop junctures for wrapped and folded loops are smoothed\cf2 \
		\cf5 // with a lowpass filter, the smooth time of which is ramped \cf2 \
		\cf5 // up and down before and after the loop juncture points to \cf2 \
		\cf5 // smooth any sudden change in amplitude and frequency values.\cf2 \
\
		\cf5 //......................................................\cf2 \
\
		\cf5 //............ FILTER SPECTRUM COMPRESSION ..............\cf2 \
		filter_spectrum_compression_threshold_in_decibels = -30 ;\
		filter_spectrum_decibels_of_compression = -0 ;\
\
		\cf5 //******************************************************\cf2 \
		\cf5 //********** AMPLITUDE STATISTICS ********************** \cf2 \
		print_amplitude_statistics_0_no__1_yes = 1 ;\
		amplitude_statistics_time_interval = 1.0 ;\
\
		\cf5 //======================================================\cf2 \
		\cf5 //========= SCRATCH SPACE ==============================\cf2 \
		\cf5 //======================================================\cf2 \
\
\
\
		\cf5 //====================================================\cf2 \
 		\cf5 //\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\'95\cf2 \
\
	\} ;\
	\cf5 //*********************************************************************************************************\cf2 \
	\cf5 //************* COMMAND LINE SETUP -- OFFICE USE ONLY ***************************************\cf2 \
	\cf5 //************* DO NOT CHANGE ANYTHING IN THE FUNCTION BELOW THIS LINE ***************\cf2 \
	\cf5 //*********************************************************************************************************\cf2 \
\
	iterations.do(\{\cf3 arg\cf2  n; \
		setRoutineVariables.value( iteration: n ) ; \
\
		\cf5 // ******** UNIX COMMAND LINE 0 ***********\cf2 \
		addCommand.value(\
\
					\cf5 // * ROUTINE * \cf2 \
			\cf4 "ringtvfilter "\cf2  ++ \cf4 " "\cf2  ++\
\
				\cf5 // * FLAGS * \cf2 \
			 \cf4 " -O"\cf2  ++ reverb_input_low_shelf_eq_gain_in_decibels ++  \cf4 " -x"\cf2  ++ reverb_filter_source_db ++ \
			 \cf4 " -A"\cf2  ++ normalize_loop_amplitudes__off_0__on_1 ++  \cf4 " -T"\cf2  ++ reverb_feedback_eq_decay_time_in_seconds ++ \
			 \cf4 " -:"\cf2  ++ onset_and_release_segment_mode__off_0__on_1 ++  \cf4 " -o"\cf2  ++ reverb_filter_on_input_0__feedback_1 ++ \
			 \cf4 " -q"\cf2  ++ reverb_filter_spectrum_warpshape ++  \cf4 " -K"\cf2  ++ reverb_random_deviation_response_time_in_seconds ++ \
			 \cf4 " -W"\cf2  ++ filter_spectrum_compression_threshold_in_decibels ++  \cf4 " -r"\cf2  ++ reverb_feedback_filter_decay_time_in_seconds ++ \
			 \cf4 " -D"\cf2  ++ frames_per_second ++  \cf4 " -n"\cf2  ++ reverb_input_high_shelf_eq_frequency ++ \
			 \cf4 " -F"\cf2  ++ reverb_gain_in_decibels ++  \cf4 " -y"\cf2  ++ reverb_filter_file ++  \cf4 " -U"\cf2  ++ reverb_feedback_low_shelf_eq_frequency ++ \
			 \cf4 " -P"\cf2  ++ reverb_pitch_transposition_in_semitones ++  \cf4 " -G"\cf2  ++ reverb_output_high_shelf_eq_frequency ++ \
			 \cf4 " -w"\cf2  ++ print_amplitude_statistics_0_no__1_yes ++  \cf4 " -e"\cf2  ++ endtime ++  \cf4 " -L"\cf2  ++ reverb_input_envelope_release_time_in_seconds ++ \
			 \cf4 " -M"\cf2  ++ windowsize ++  \cf4 " -z"\cf2  ++ reverb_threshold_in_db ++  \cf4 " -/Q"\cf2  ++ sampler_loop_mode__wrap_0__fold_1__clip_2 ++ \
			 \cf4 " -v"\cf2  ++ filter_spectrum_decibels_of_compression ++  \cf4 " -c"\cf2  ++ reverb_output_high_shelf_eq_gain_in_decibels ++ \
			 \cf4 " -m"\cf2  ++ reverb_feedback_high_shelf_eq_frequency ++  \cf4 " -X"\cf2  ++ reverb_feedback_low_shelf_eq_gain_in_decibels ++ \
			 \cf4 " -k"\cf2  ++ reverb_output_low_shelf_eq_gain_in_decibels ++  \cf4 " -p"\cf2  ++ source_pitch_transposition_in_semitones ++ \
			 \cf4 " -i"\cf2  ++ amplitude_statistics_time_interval ++  \cf4 " -J"\cf2  ++ filter_upper_time_boundary ++ \
			 \cf4 " -//"\cf2  ++ window_type ++  \cf4 " -l"\cf2  ++ reverb_input_envelope_attack_time_in_seconds ++ \
			 \cf4 " -E"\cf2  ++ reverb_feedback_eq_signal_balance_gain_limiter_in_db ++  \cf4 " -b"\cf2  ++ begintime ++ \
			 \cf4 " -I"\cf2  ++ time_expansion_contraction_factor ++  \cf4 " -N"\cf2  ++ fft_length ++  \cf4 " -C"\cf2  ++ output_channel ++ \
			 \cf4 " -S"\cf2  ++ source_gain_in_decibels ++  \cf4 " -s"\cf2  ++ reverb_output_low_shelf_eq_frequency ++ \
			 \cf4 " -g"\cf2  ++ filter_lower_time_boundary ++  \cf4 " -j"\cf2  ++ reverb_random_freq_deviation_proportion ++ \
			 \cf4 " -R"\cf2  ++ filter_rate_multiplier ++  \cf4 " -Z"\cf2  ++ reverb_decay_time_in_seconds ++ \
			 \cf4 " -a"\cf2  ++ loop_smooth_time_in_seconds ++  \cf4 " -B"\cf2  ++ p_change_select__source_only_0__both_source_and_filter_1 ++ \
			 \cf4 " -d"\cf2  ++ reverb_input_low_shelf_eq_frequency ++  \cf4 " -Y"\cf2  ++ reverb_input_high_shelf_eq_gain_in_decibels ++ \
			 \cf4 " -~"\cf2  ++ analysis_channel ++  \cf4 " -="\cf2  ++ rescale_level_in_decibels ++  \cf4 " -V"\cf2  ++ reverb_filter_shift ++ \
			 \cf4 " -_"\cf2  ++ auto_output_sound_file_play__repetitions ++  \cf4 " -f"\cf2  ++ source_frequency_shift ++ \
			 \cf4 " -h"\cf2  ++ filter_time_point_origin ++  \cf4 " -@"\cf2  ++ mode__sampler_loop_0__autostop_1 ++ \
			 \cf4 " -Q"\cf2  ++ reverb_feedback_high_shelf_eq_gain_in_decibels ++  \cf4 " -u"\cf2  ++ reverb_filter_transposition_in_semitones ++ \
			 \cf4 " -t"\cf2  ++ oscillator_resynthesis_threshold_in_db ++  \cf4 " -H"\cf2  ++ reverb_frequency_shift\
\
				\cf5 // * INPUT/OUTPUT FILES * \cf2 \
			 ++  \cf4 " "\cf2   ++ input_file ++ \cf4 "  "\cf2  ++  \cf4 " "\cf2   ++ output_file\
\
		) ;\
 \
\
\
	\}) ;\
\} ;\
\
\
\
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\cf5 //         ---------- FUNCTION CALLS  ----------            \cf2 \
\cf5 /////////////////////////////////////////////////////////////////////////////////////\cf2 \
\
\
\cf5 // *** CLEAR SCREEN ***\cf2 \
\cf3 Document\cf2 .listener.string=\cf4 ""\cf2 ; \
\
ringtvfilter.value( iterations: 1 ) ; \
\
runCommands.value ;\
