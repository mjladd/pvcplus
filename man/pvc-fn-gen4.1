\fBpvc\-fn\-gen4\fR <\fB\-L\fR|\fB\-\-length\fR> [\fB\-\-open\fR] <\fB\-\-point\fR> [\fB\-h\fR|\fB\-\-help\fR] <\fIOUTPUT\fR> 
